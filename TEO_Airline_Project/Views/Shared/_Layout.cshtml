@{
    var isAuthenticated = !string.IsNullOrWhiteSpace(Context.Session.GetString("UserId"));
    var currentFullName = Context.Session.GetString("FullName");
    if (string.IsNullOrWhiteSpace(currentFullName))
    {
        currentFullName = Context.Session.GetString("Username") ?? "Tài khoản";
    }

    var currentAction = ViewContext.RouteData.Values["action"] as string ?? "Index";
    bool IsCurrent(string action) => string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    var pageTitle = ViewData["Title"] as string ?? "TEO Airlines — Đặt vé máy bay";
}
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0F766E">
  <meta name="description" content="Tìm và đặt chuyến bay cùng TEO Airlines.">
  <title>@pageTitle</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
  <link rel="stylesheet" href="~/css/style.css">
</head>
<body class="min-h-screen bg-page text-ink antialiased">
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" asp-controller="Home" asp-action="Index" data-screen-link="home" aria-label="TEO Airlines — Trang chủ">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.8 3.2c-.9-.9-2.2-.4-3.1.5l-4.3 4.3-7.8-2c-.5-.1-1 .1-1.4.4l-.9.9 5.7 3.2-3.1 3.1-2.8-.7L2 14l3.7 1.8L7.5 19l1.1-1.1-.7-2.8 3.1-3.1 3.2 5.7.9-.9c.4-.4.5-.9.4-1.4l-2-7.8 4.3-4.3c.9-.9 1.4-2.2.5-3.1z"></path>
          </svg>
        </span>
        <span class="brand-wordmark"><strong>TEO</strong><small>airlines</small></span>
      </a>

      <nav class="main-nav" aria-label="Điều hướng chính">
        <a class="nav-link @(IsCurrent("Index") ? "is-active" : null)" asp-controller="Home" asp-action="Index" data-screen-link="home" aria-current="@(IsCurrent("Index") ? "page" : null)">Đặt vé</a>
        <a class="nav-link @(IsCurrent("Lookup") ? "is-active" : null)" asp-controller="Home" asp-action="Lookup" aria-current="@(IsCurrent("Lookup") ? "page" : null)">Tra cứu đặt chỗ</a>
        <a class="nav-link @(IsCurrent("Rewards") ? "is-active" : null)" asp-controller="Home" asp-action="Rewards" aria-current="@(IsCurrent("Rewards") ? "page" : null)">Đổi điểm</a>
        <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="support">Hỗ trợ</a>
      </nav>

      <div class="header-actions">
        @if (isAuthenticated)
        {
          <details class="account-menu">
            <summary class="button button-outline account-trigger">
              <i data-lucide="user-round" aria-hidden="true"></i><span class="account-name">@currentFullName</span><i data-lucide="chevron-down" aria-hidden="true"></i>
            </summary>
            <div class="account-popover">
              <p class="account-popover-label">@currentFullName</p>
              <button class="account-signout" type="button" data-signout-open>
                <i data-lucide="log-out" aria-hidden="true"></i><span>Đăng xuất</span>
              </button>
            </div>
          </details>
        }
        else
        {
          <a class="button button-outline header-login" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
          <a class="button button-primary header-register" href="register.html">Đăng ký</a>
        }
      </div>

      <button class="icon-button menu-toggle" type="button" aria-label="Mở menu" aria-expanded="false" aria-controls="mobile-menu">
        <i data-lucide="menu" aria-hidden="true"></i>
      </button>
    </div>
    <nav class="mobile-menu" id="mobile-menu" aria-label="Điều hướng trên điện thoại" hidden>
      <a asp-controller="Home" asp-action="Index" data-screen-link="home">Đặt vé</a>
      <a asp-controller="Home" asp-action="Lookup">Tra cứu đặt chỗ</a>
      <a asp-controller="Home" asp-action="Rewards">Đổi điểm</a>
      <a asp-controller="Home" asp-action="Index" asp-fragment="support">Hỗ trợ</a>
      @if (isAuthenticated)
      {
        <div class="mobile-account">
          <span class="mobile-account-label">@currentFullName</span>
          <button class="account-signout" type="button" data-signout-open>
            <i data-lucide="log-out" aria-hidden="true"></i><span>Đăng xuất</span>
          </button>
        </div>
      }
      else
      {
        <a asp-controller="Auth" asp-action="Login">Đăng nhập</a>
        <a href="register.html">Đăng ký</a>
      }
    </nav>
  </header>

  @RenderBody()

    <footer class="site-footer" id="support">
        <div class="container footer-inner">
            <div class="footer-brand">
                <a class="brand brand-footer" asp-controller="Home" asp-action="Index" data-screen-link="home">
                    <span class="brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.8 3.2c-.9-.9-2.2-.4-3.1.5l-4.3 4.3-7.8-2c-.5-.1-1 .1-1.4.4l-.9.9 5.7 3.2-3.1 3.1-2.8-.7L2 14l3.7 1.8L7.5 19l1.1-1.1-.7-2.8 3.1-3.1 3.2 5.7.9-.9c.4-.4.5-.9.4-1.4l-2-7.8 4.3-4.3c.9-.9 1.4-2.2.5-3.1z"></path></svg>
                    </span>
                    <span class="brand-wordmark"><strong>TEO</strong><small>airlines</small></span>
                </a>
                <p>© 2026 TEO Airlines · Giao diện minh họa</p>
            </div>
            <div class="footer-contact">
                <div class="footer-contact-list" aria-label="Thông tin liên hệ">
                    <a class="footer-contact-item" href="tel:19000000">
                        <i data-lucide="phone" aria-hidden="true"></i><span><small>Điện thoại</small><strong>1900 0000</strong></span>
                    </a>
                    <a class="footer-contact-item" href="mailto:hotro@teoairlines.vn">
                        <i data-lucide="mail" aria-hidden="true"></i><span><small>Email</small><strong>hotro@teoairlines.vn</strong></span>
                    </a>
                    <span class="footer-contact-item">
                        <i data-lucide="map-pin" aria-hidden="true"></i><span><small>Văn phòng</small><strong>Tòa nhà TEO, TP. Hồ Chí Minh</strong></span>
                    </span>
                </div>
                <div class="footer-social">
                    <span>Theo dõi TEO</span>
                    <div class="social-links" aria-label="Các kênh mạng xã hội">
                        <a href="#support" data-social-channel="Facebook" aria-label="Facebook — kênh mẫu">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.7V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V10H7.3v3h2.8v8z"></path></svg>
                        </a>
                        <a href="#support" data-social-channel="TikTok" aria-label="TikTok — kênh mẫu">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.6 8.2a7.8 7.8 0 0 1-4.7-1.6v7.1a6.1 6.1 0 1 1-5.2-6v3.5a2.7 2.7 0 1 0 1.8 2.5V2.5h3.4c.2 1.8 1.3 3.3 3.1 4v1.7c.5.1 1 .1 1.6 0z"></path></svg>
                        </a>
                        <a href="#support" data-social-channel="YouTube" aria-label="YouTube — kênh mẫu">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.2 7a3 3 0 0 0-2.1-2.1C19.2 4.4 12 4.4 12 4.4s-7.2 0-9.1.5A3 3 0 0 0 .8 7 31 31 0 0 0 .3 12a31 31 0 0 0 .5 5 3 3 0 0 0 2.1 2.1c1.9.5 9.1.5 9.1.5s7.2 0 9.1-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-5 31 31 0 0 0-.5-5zm-13.4 8.6V8.4l6.2 3.6z"></path></svg>
                        </a>
                        <a href="#support" data-social-channel="Instagram" aria-label="Instagram — kênh mẫu">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 2h9.6A5.2 5.2 0 0 1 22 7.2v9.6a5.2 5.2 0 0 1-5.2 5.2H7.2A5.2 5.2 0 0 1 2 16.8V7.2A5.2 5.2 0 0 1 7.2 2zm0 2.2a3 3 0 0 0-3 3v9.6a3 3 0 0 0 3 3h9.6a3 3 0 0 0 3-3V7.2a3 3 0 0 0-3-3zm4.8 3.1a4.7 4.7 0 1 1 0 9.4 4.7 4.7 0 0 1 0-9.4zm0 2.2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zm5-4a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2z"></path></svg>
                        </a>
                    </div>
                </div>
                <p class="footer-contact-note">Thông tin liên hệ và mạng xã hội là dữ liệu mẫu, chưa kết nối kênh chính thức.</p>
            </div>
            <nav class="footer-links" aria-label="Liên kết hỗ trợ">
                <a asp-controller="Home" asp-action="Index" asp-fragment="support">Hỗ trợ khách hàng</a>
                <a asp-controller="Home" asp-action="Rewards">Đổi điểm</a>
                <a href="#terms" data-coming-soon>Điều khoản</a>
                <a href="#privacy" data-coming-soon>Chính sách riêng tư</a>
            </nav>
        </div>
    </footer>

    <dialog class="logout-dialog" id="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
        <div class="logout-heading">
            <span class="logout-icon"><i data-lucide="log-out" aria-hidden="true"></i></span>
            <div>
                <h2 id="logout-title">Đăng xuất khỏi tài khoản?</h2>
                <p id="logout-description">Bạn sẽ cần đăng nhập lại để tiếp tục.</p>
            </div>
        </div>
        <div class="logout-account">
            <i data-lucide="user-round" aria-hidden="true"></i><span>@currentFullName</span>
        </div>
        <form class="logout-actions" asp-controller="Auth" asp-action="Logout" method="post">
            <button class="button button-secondary" type="button" data-signout-cancel>Huỷ</button>
            <button class="button button-danger" type="submit" data-signout-confirm>Đăng xuất</button>
        </form>
    </dialog>

    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
    <script src="~/js/auth.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>