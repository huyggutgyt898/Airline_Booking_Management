          <p data-aircraft-dialog-description>Máy bay và các ghế sẽ được lưu cùng nhau.</p>
        </div>
        <button class="admin-icon-button" type="button" data-aircraft-dialog-close aria-label="Đóng cửa sổ">
          <i data-lucide="x" aria-hidden="true"></i>
        </button>
      </header>
      <div class="admin-validation-summary" asp-validation-summary="All" role="alert"></div>
      <input type="hidden" name="aircraftId" value="@Model.SelectedAircraftId">
      <input type="hidden" name="selectedAircraftId" value="@Model.SelectedAircraftId">
      <input type="hidden" name="routePage" value="@Model.RoutePage">
      <input type="hidden" name="routeSearch" value="@Model.RouteSearch">
      <input type="hidden" name="routeType" value="@Model.RouteTypeFilter">
      <input type="hidden" name="flightPage" value="@Model.FlightPage">
      <input type="hidden" name="flightSearch" value="@Model.FlightSearch">
      <input type="hidden" name="flightStatus" value="@Model.FlightStatusFilter">
      <div class="admin-dialog-fields">
        <div class="admin-field admin-field-full">
          <label asp-for="AircraftInput.Model"></label>
          <input asp-for="AircraftInput.Model" maxlength="100" autocomplete="off" required>
          <span class="admin-validation-message" asp-validation-for="AircraftInput.Model"></span>
        </div>
        <div class="admin-field aircraft-create-only">
          <label asp-for="AircraftInput.RowCount"></label>
          <input asp-for="AircraftInput.RowCount" type="number" min="1" max="99" required>
          <span class="admin-validation-message" asp-validation-for="AircraftInput.RowCount"></span>
        </div>
        <div class="admin-field aircraft-create-only">
          <label asp-for="AircraftInput.SeatsPerRow"></label>
          <input asp-for="AircraftInput.SeatsPerRow" type="number" min="1" max="6"
                 aria-describedby="aircraft-seat-layout-help" required>
          <span class="admin-validation-message" asp-validation-for="AircraftInput.SeatsPerRow"></span>
        </div>
        <div class="admin-field aircraft-create-only">
          <label asp-for="AircraftInput.BusinessRows"></label>
          <input asp-for="AircraftInput.BusinessRows" type="number" min="0" max="99"
                 aria-describedby="aircraft-business-rows-help" required>
          <span class="admin-validation-message" asp-validation-for="AircraftInput.BusinessRows"></span>
        </div>
        <div class="admin-field aircraft-create-only admin-field-full">
          <p class="admin-footnote" id="aircraft-seat-layout-help">Ghế xếp theo thứ tự A–F, lối đi sau ghế C. Số ghế mỗi hàng mặc định là 6 (3–3).</p>
          <p class="admin-footnote" id="aircraft-business-rows-help">Các hàng đầu tiên được gán hạng thương gia; những hàng còn lại là phổ thông.</p>
        </div>
      </div>
      <footer class="admin-dialog-actions">
        <button class="admin-button admin-button-outline" type="button" data-aircraft-dialog-close>Hủy</button>
        <button class="admin-button admin-button-primary" type="submit" data-aircraft-submit>Thêm máy bay</button>
      </footer>
    </form>
  </dialog>

  <dialog class="logout-dialog" id="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
    <div class="logout-heading">
      <span class="logout-icon"><i data-lucide="log-out" aria-hidden="true"></i></span>
      <div>
        <h2 id="logout-title">Đăng xuất khỏi tài khoản?</h2>
        <p id="logout-description">Bạn sẽ cần đăng nhập lại để tiếp tục.</p>
      </div>
    </div>
    <div class="logout-account">
      <i data-lucide="user-round" aria-hidden="true"></i><span>@fullName</span>
    </div>
    <form class="logout-actions" asp-controller="Auth" asp-action="Logout" method="post">
      <button class="button button-secondary" type="button" data-signout-cancel>Huỷ</button>
      <button class="button button-danger" type="submit" data-signout-confirm>Đăng xuất</button>
    </form>
  </dialog>
  <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
  <div class="admin-toast" role="status" aria-live="polite"
       data-initial-message="@adminNotice" hidden></div>
  <script src="~/js/admin.js"></script>
  <script src="~/js/auth.js"></script>
</body>
</html>
