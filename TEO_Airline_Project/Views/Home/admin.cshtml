@model TEO_Airline_Project.Models.ViewModels.AdminDashboardViewModel
@using TEO_Airline_Project.Models.ViewModels
@using TEO_Airline_Project.Services
@{
    Layout = null;
    var fullName = ViewContext.HttpContext.Session.GetString("FullName") ?? "Quản trị viên";
    var initials = string.Concat(
        fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .TakeLast(2)
            .Select(part => char.ToUpperInvariant(part[0])));
    string RoutePageUrl(int routePageNumber)
    {
        return Url.Action("Admin", "Home", new
        {
            routePage = routePageNumber,
            routeSearch = Model.RouteSearch,
            routeType = Model.RouteTypeFilter,
            flightPage = Model.FlightPage,
            flightSearch = Model.FlightSearch,
            flightStatus = Model.FlightStatusFilter,
            aircraftId = Model.SelectedAircraftId
        }) + "#routes";
    }
    string FlightPageUrl(int flightPageNumber)
    {
        return Url.Action("Admin", "Home", new
        {
            routePage = Model.RoutePage,
            routeSearch = Model.RouteSearch,
            routeType = Model.RouteTypeFilter,
            flightPage = flightPageNumber,
            flightSearch = Model.FlightSearch,
            flightStatus = Model.FlightStatusFilter,
            aircraftId = Model.SelectedAircraftId
        }) + "#flights";
    }
    string ClearFlightFiltersUrl()
    {
        return Url.Action("Admin", "Home", new
        {
            routePage = Model.RoutePage,
            routeSearch = Model.RouteSearch,
            routeType = Model.RouteTypeFilter,
            flightPage = 1,
            aircraftId = Model.SelectedAircraftId
        }) + "#flights";
    }
    string AircraftPageUrl(int aircraftId)
    {
        return Url.Action("Admin", "Home", new
        {
            routePage = Model.RoutePage,
            routeSearch = Model.RouteSearch,
            routeType = Model.RouteTypeFilter,
            flightPage = Model.FlightPage,
            flightSearch = Model.FlightSearch,
            flightStatus = Model.FlightStatusFilter,
            aircraftId
        }) + "#aircraft";
    }
    var selectedAircraft = Model.Aircrafts.FirstOrDefault(
        aircraft => aircraft.AircraftId == Model.SelectedAircraftId);
    var aircraftNotice = TempData["AircraftSuccess"] as string ?? TempData["AircraftError"] as string;
    var pricingNotice = TempData["PricingSuccess"] as string ?? TempData["PricingError"] as string;
    var adminNotice = pricingNotice ?? aircraftNotice;
    var seatColumns = new[] { "A", "B", "C", "D", "E", "F" };
    var pricingSeatClassGroups = Model.FlightPricingRows
        .GroupBy(price => price.SeatClass)
        .ToList();
    var editingPricingRow = Model.FlightPricingRows.FirstOrDefault(
        price => price.PriceId == Model.EditingFlightPriceId);
    var moneyCulture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    string SeatClassLabel(string value) => value switch
    {
        "Economy" => "Phổ thông",
        "Business" => "Thương gia",
        _ => value
    };
    string PassengerTypeLabel(string value) => value switch
    {
        "Adult" => "Người lớn",
        "Child" => "Trẻ em",
        "Infant" => "Em bé",
        _ => value
    };
    string Money(decimal value) => value.ToString(value % 1 == 0 ? "N0" : "N2", moneyCulture) + " ₫";
}
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0F766E">
  <meta name="description" content="Giao diện quản trị hệ thống TEO Airlines.">
  <title>Tổng quan — TEO Airlines</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
  <link rel="stylesheet" href="~/css/style.css">
  <link rel="stylesheet" href="~/css/admin.css">
</head>
<body class="admin-page">
  <button class="admin-scrim" type="button" data-menu-close aria-label="Đóng menu" hidden></button>
  <div class="admin-shell">
    <aside class="admin-sidebar" id="admin-sidebar" aria-label="Điều hướng quản trị">
      <a class="admin-brand" asp-controller="Home" asp-action="Admin" asp-fragment="overview" aria-label="TEO Airlines — Quản trị hệ thống">
        <span class="admin-brand-mark" aria-hidden="true"><i data-lucide="plane"></i></span>
        <span class="admin-brand-copy"><strong>TEO Airlines</strong><span>Quản trị hệ thống</span></span>
      </a>

      <nav class="admin-nav" aria-label="Chức năng quản trị">
        <p class="admin-nav-label">Phân tích</p>
        <a class="admin-nav-link" href="#overview" data-admin-screen="overview" aria-current="page"><i data-lucide="chart-no-axes-combined" aria-hidden="true"></i><span>Tổng quan</span></a>

        <p class="admin-nav-label admin-nav-label-spaced">Vận hành</p>
        <a class="admin-nav-link" href="#airports" data-admin-screen="airports"><i data-lucide="map-pin" aria-hidden="true"></i><span>Sân bay</span></a>
        <a class="admin-nav-link" href="#routes" data-admin-screen="routes"><i data-lucide="route" aria-hidden="true"></i><span>Tuyến bay</span></a>
        <a class="admin-nav-link" href="#flights" data-admin-screen="flights"><i data-lucide="plane-takeoff" aria-hidden="true"></i><span>Chuyến bay</span></a>
        <a class="admin-nav-link" href="#aircraft" data-admin-screen="aircraft"><i data-lucide="plane" aria-hidden="true"></i><span>Máy bay &amp; sơ đồ ghế</span></a>

        <p class="admin-nav-label admin-nav-label-spaced">Thương mại</p>
        <a class="admin-nav-link" href="#pricing" data-admin-screen="pricing"><i data-lucide="badge-dollar-sign" aria-hidden="true"></i><span>Bảng giá</span></a>
        <a class="admin-nav-link" href="#promotions" data-admin-screen="promotions"><i data-lucide="ticket-percent" aria-hidden="true"></i><span>Khuyến mãi</span></a>
      </nav>

      <div class="admin-sidebar-spacer"></div>
      <details class="admin-account-menu">
        <summary class="admin-agent">
          <span class="admin-avatar" aria-hidden="true">@initials</span>
          <span class="admin-agent-copy"><strong>@fullName</strong><span>Quản lý hệ thống</span></span>
          <i data-lucide="chevron-up" aria-hidden="true"></i>
        </summary>
        <div class="admin-account-popover">
          <button class="admin-account-signout" type="button" data-signout-open><i data-lucide="log-out" aria-hidden="true"></i><span>Đăng xuất</span></button>
        </div>
      </details>
    </aside>

    <main class="admin-main">
      <header class="admin-topbar">
        <button class="admin-menu-toggle" type="button" data-menu-toggle aria-label="Mở menu" aria-controls="admin-sidebar" aria-expanded="false"><i data-lucide="menu" aria-hidden="true"></i></button>
        <p class="admin-breadcrumb">TEO Airlines <span aria-hidden="true">/</span> <strong data-page-title>Tổng quan</strong></p>
        <div class="admin-topbar-meta"><span>Trung tâm vận hành</span><span class="admin-avatar admin-avatar-small" aria-label="@fullName">@initials</span></div>
      </header>

      <div class="admin-content">
        <section class="admin-screen" data-screen-panel="overview">
          <div class="admin-page-heading admin-overview-heading">
            <div><h1>Tổng quan</h1><p>Theo dõi hoạt động bán vé và hiệu quả khai thác.</p></div>
            <button class="admin-button admin-button-outline" type="button" data-export="report"><i data-lucide="download" aria-hidden="true"></i>Xuất Excel</button>
          </div>

          <div class="admin-dashboard-toolbar">
            <div class="admin-period-tabs" role="group" aria-label="Khoảng thời gian báo cáo">
              <button type="button" data-period="day">Ngày</button>
              <button type="button" data-period="week">Tuần</button>
              <button type="button" data-period="month" aria-pressed="true">Tháng</button>
              <button type="button" data-period="quarter">Quý</button>
              <button type="button" data-period="year">Năm</button>
              <button type="button" data-period="all">Toàn bộ lịch sử</button>
            </div>
            <span class="admin-period-date" data-period-caption>01–31 tháng 10, 2026</span>
          </div>

          <div class="admin-metrics" aria-label="Chỉ số trong kỳ">
            <article class="admin-metric">
              <div class="admin-metric-top"><span>Doanh thu</span><span class="admin-metric-icon"><i data-lucide="badge-dollar-sign" aria-hidden="true"></i></span></div>
              <strong data-metric="revenue">1,28 tỷ ₫</strong><small class="admin-positive"><i data-lucide="trending-up" aria-hidden="true"></i><span data-metric-change>12,8%</span> so với kỳ trước</small>
            </article>
            <article class="admin-metric">
              <div class="admin-metric-top"><span>Vé đã đặt</span><span class="admin-metric-icon"><i data-lucide="ticket" aria-hidden="true"></i></span></div>
              <strong data-metric="bookings">3.842</strong><small class="admin-positive"><i data-lucide="trending-up" aria-hidden="true"></i>8,4% so với kỳ trước</small>
            </article>
            <article class="admin-metric">
              <div class="admin-metric-top"><span>Tỉ lệ lấp đầy ghế</span><span class="admin-metric-icon"><i data-lucide="armchair" aria-hidden="true"></i></span></div>
              <strong data-metric="occupancy">82,6%</strong><small>Trên <span data-metric="seat-count">4.650</span> ghế khai thác</small>
            </article>
            <article class="admin-metric admin-ticket-metric">
              <div class="admin-metric-top"><span>Vé bán / hủy / đổi</span><span class="admin-metric-icon"><i data-lucide="chart-no-axes-column" aria-hidden="true"></i></span></div>
              <div class="admin-ticket-counts">
                <div><strong data-metric="sold">3.610</strong><span>Bán</span></div>
                <div><strong data-metric="cancelled">106</strong><span>Hủy</span></div>
                <div><strong data-metric="changed">126</strong><span>Đổi</span></div>
              </div>
              <small data-ticket-caption>Trong kỳ đã chọn</small>
            </article>
            <article class="admin-metric">
              <div class="admin-metric-top"><span>Lượt truy cập website</span><span class="admin-metric-icon"><i data-lucide="mouse-pointer-click" aria-hidden="true"></i></span></div>
              <strong data-metric="visits">326.480</strong>
              <small>Trong kỳ đã chọn</small>
            </article>
          </div>

          <div class="admin-dashboard-grid">
            <section class="admin-panel admin-revenue-panel">
              <header class="admin-panel-heading">
                <div><h2>Xu hướng doanh thu</h2><p data-chart-caption>Doanh thu thuần theo ngày trong tháng</p></div>
                <div class="admin-segmented" role="group" aria-label="Chỉ số biểu đồ">
                  <button type="button" data-chart-mode="revenue" aria-pressed="true">Doanh thu</button>
                  <button type="button" data-chart-mode="tickets">Số vé</button>
                </div>
              </header>
              <div class="admin-chart" data-chart aria-label="Biểu đồ cột doanh thu"></div>
            </section>

            <section class="admin-panel admin-promos-panel">
              <header class="admin-panel-heading">
                <div><h2>Khuyến mãi nổi bật</h2><p>Lượt dùng lũy kế</p></div>
                <a class="admin-text-link" href="#promotions" data-admin-screen="promotions">Danh sách</a>
              </header>
              <div class="admin-promo-list" data-promo-summary>
                @if (Model.PromotionHighlights.Count == 0)
                {
                  <p class="admin-promo-empty">Chưa có mã khuyến mãi.</p>
                }
                @foreach (var promotion in Model.PromotionHighlights)
                {
                  var discountLabel = promotion.DiscountPercent is decimal percent
                      ? $"{percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%"
                      : $"{promotion.DiscountAmount?.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ?? "0"} ₫";
                  <div class="admin-promo-row">
                    <div><strong>@promotion.Code</strong><span>@discountLabel@if (promotion.PointsRequired is int points){<text> · @points điểm</text>}</span></div>
                    <b>@promotion.UsedCount lượt</b>
                  </div>
                }
              </div>
              <p class="admin-promo-summary">Tổng lượt dùng: <strong>@Model.TotalPromotionUsageCount</strong> · @Model.PromotionHighlights.Count mã đang theo dõi</p>
            </section>

          </div>
        </section>

        <section class="admin-screen" data-screen-panel="airports" hidden>
          <div class="admin-page-heading">
            <div><h1>Sân bay</h1><p>Quản lý mã sân bay và thông tin địa điểm.</p></div>
            <button class="admin-button admin-button-primary" type="button" data-airport-create><i data-lucide="plus" aria-hidden="true"></i>Thêm sân bay</button>
          </div>
          @if (TempData["AirportSuccess"] is string airportSuccess)
          {
            <div class="admin-feedback" role="status">@airportSuccess</div>
          }
          @if (TempData["AirportError"] is string airportError)
          {
            <div class="admin-feedback admin-feedback-error" role="alert">@airportError</div>
          }
          <div class="admin-list-tools"><label class="admin-search"><i data-lucide="search" aria-hidden="true"></i><span class="admin-sr-only">Tìm sân bay</span><input type="search" placeholder="Tìm mã, tên hoặc thành phố" data-table-filter="airports-table"></label><span class="admin-result-count" data-airports-count>@Model.Airports.Count sân bay</span></div>
          <div class="admin-table-panel"><table class="admin-table" id="airports-table">
            <thead><tr><th>Mã</th><th>Tên sân bay</th><th>Thành phố</th><th>Quốc gia</th><th class="admin-actions-heading">Thao tác</th></tr></thead>
            <tbody>
              @foreach (var airport in Model.Airports)
              {
                <tr data-airport-row>
                  <td data-label="Mã"><strong>@airport.AirportCode</strong></td>
                  <td data-label="Tên sân bay">@airport.AirportName</td>
                  <td data-label="Thành phố">@airport.City</td>
                  <td data-label="Quốc gia">@airport.Country</td>
                  <td data-label="Thao tác">
                    <div class="admin-row-actions">
                      <button class="admin-button admin-button-small" type="button"
                              data-airport-edit
                              data-code="@airport.AirportCode"
                              data-name="@airport.AirportName"
                              data-city="@airport.City"
                              data-country="@airport.Country">Sửa</button>
                      <button class="admin-button admin-button-small admin-button-ghost" type="button"
                              data-airport-delete
                              data-code="@airport.AirportCode">Xóa</button>
                    </div>
                  </td>
                </tr>
              }
              <tr data-airports-empty hidden><td colspan="5">Không tìm thấy sân bay phù hợp.</td></tr>
            </tbody>
          </table><div class="admin-table-footer"><span data-airports-summary></span><div class="admin-pagination" data-airports-pagination></div></div></div>
        </section>

        <section class="admin-screen" data-screen-panel="routes" hidden>
          <div class="admin-page-heading">
            <div><h1>Tuyến bay</h1><p>Quản lý cặp sân bay khởi hành và điểm đến.</p></div>
            <button class="admin-button admin-button-primary" type="button" data-route-create><i data-lucide="plus" aria-hidden="true"></i>Thêm tuyến bay</button>
          </div>
          @if (TempData["RouteSuccess"] is string routeSuccess)
          {
            <div class="admin-feedback" role="status">@routeSuccess</div>
          }
          @if (TempData["RouteError"] is string routeError)
          {
            <div class="admin-feedback admin-feedback-error" role="alert">@routeError</div>
          }
          <form class="admin-list-tools" method="get" asp-controller="Home" asp-action="Admin" asp-fragment="routes">
            <input type="hidden" name="routePage" value="1">
            <label class="admin-search"><i data-lucide="search" aria-hidden="true"></i><span class="admin-sr-only">Tìm tuyến bay</span><input type="search" name="routeSearch" value="@Model.RouteSearch" placeholder="Tìm mã sân bay hoặc thành phố" data-route-search></label>
            <label class="admin-select-label"><span class="admin-sr-only">Lọc loại tuyến</span><select name="routeType" data-route-type-filter>
              <option value="" selected="@(string.IsNullOrEmpty(Model.RouteTypeFilter))">Tất cả loại tuyến</option>
              <option value="Domestic" selected="@(Model.RouteTypeFilter == "Domestic")">Nội địa</option>
              <option value="International" selected="@(Model.RouteTypeFilter == "International")">Quốc tế</option>
            </select></label>
            <span class="admin-result-count" data-route-count>
              @Model.TotalRouteCount tuyến bay · @Model.TotalFlightCount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) chuyến bay
            </span>
          </form>
          <div class="admin-table-panel"><table class="admin-table" id="routes-table">
            <thead><tr><th>Mã tuyến</th><th>Điểm đi</th><th>Điểm đến</th><th>Loại tuyến</th><th>Chuyến bay</th><th class="admin-actions-heading">Thao tác</th></tr></thead>
            <tbody>
              @foreach (var route in Model.Routes)
              {
                var routeTypeLabel = route.RouteType == "International" ? "Quốc tế" : "Nội địa";
                <tr>
                  <td data-label="Mã tuyến"><strong>R-@route.RouteId.ToString("D3")</strong></td>
                  <td data-label="Điểm đi">@route.DepartureAirportCode · @route.DepartureAirportCity</td>
                  <td data-label="Điểm đến">@route.ArrivalAirportCode · @route.ArrivalAirportCity</td>
                  <td data-label="Loại tuyến"><span class="admin-badge @(route.RouteType == "International" ? "admin-badge-info" : "admin-badge-neutral")">@routeTypeLabel</span></td>
                  <td data-label="Chuyến bay">@route.FlightCount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) chuyến</td>
                  <td data-label="Thao tác">
                    <div class="admin-row-actions">
                      <button class="admin-button admin-button-small" type="button" data-route-edit
                              data-id="@route.RouteId"
                              data-departure="@route.DepartureAirportCode"
                              data-arrival="@route.ArrivalAirportCode"
                              data-type="@route.RouteType">Sửa</button>
                      <button class="admin-button admin-button-small admin-button-ghost" type="button"
                              data-route-delete
                              data-id="@route.RouteId"
                              data-name="R-@route.RouteId.ToString("D3") · @route.DepartureAirportCode → @route.ArrivalAirportCode">Xóa</button>
                    </div>
                  </td>
                </tr>
              }
              @if (Model.FilteredRouteCount == 0)
              {
                <tr><td colspan="6">Không tìm thấy tuyến bay phù hợp.</td></tr>
              }
            </tbody>
          </table><div class="admin-table-footer">
            <span>
              @if (Model.FilteredRouteCount == 0)
              {
                @:Không có tuyến bay phù hợp
              }
              else
              {
                var firstRoute = (Model.RoutePage - 1) * TEO_Airline_Project.Services.AdminDashboardViewModelBuilder.RoutePageSize + 1;
                var lastRoute = Math.Min(Model.RoutePage * TEO_Airline_Project.Services.AdminDashboardViewModelBuilder.RoutePageSize, Model.FilteredRouteCount);
                @:Hiển thị @firstRoute–@lastRoute trên @Model.FilteredRouteCount tuyến bay
              }
            </span>
            <div class="admin-pagination">
              @if (Model.RoutePage > 1)
              {
                <a href="@RoutePageUrl(Model.RoutePage - 1)" aria-label="Trang trước">‹</a>
              }
              else
              {
                <span aria-disabled="true">‹</span>
              }
              @{
                  var firstPage = Math.Max(1, Model.RoutePage - 2);
                  var lastPage = Math.Min(Model.RoutePageCount, Model.RoutePage + 2);
                  if (firstPage > 1)
                  {
                    <a href="@RoutePageUrl(1)">1</a>
                    if (firstPage > 2)
                    {
                      <span class="admin-pagination-ellipsis" aria-hidden="true">…</span>
                    }
                  }
                  for (var page = firstPage; page <= lastPage; page++)
                  {
                    if (page == Model.RoutePage)
                    {
                      <span aria-current="page">@(page)</span>
                    }
                    else
                    {
                      <a href="@RoutePageUrl(page)">@(page)</a>
                    }
                  }
                  if (lastPage < Model.RoutePageCount)
                  {
                    if (lastPage < Model.RoutePageCount - 1)
                    {
                      <span class="admin-pagination-ellipsis" aria-hidden="true">…</span>
                    }
                    <a href="@RoutePageUrl(Model.RoutePageCount)">@Model.RoutePageCount</a>
                  }
              }
              @if (Model.RoutePage < Model.RoutePageCount)
              {
                <a href="@RoutePageUrl(Model.RoutePage + 1)" aria-label="Trang sau">›</a>
              }
              else
              {
                <span aria-disabled="true">›</span>
              }
            </div>
          </div></div>
        </section>

        <section class="admin-screen" data-screen-panel="flights" hidden>
          <div class="admin-page-heading">
            <div><h1>Chuyến bay</h1><p>Lịch khai thác, tàu bay và trạng thái chuyến.</p></div>
            <button class="admin-button admin-button-primary" type="button" data-flight-create><i data-lucide="plus" aria-hidden="true"></i>Thêm chuyến bay</button>
          </div>
          @if (TempData["FlightSuccess"] is string flightSuccess)
          {
            <div class="admin-feedback" role="status">@flightSuccess</div>
          }
          @if (TempData["FlightError"] is string flightError)
          {
            <div class="admin-feedback admin-feedback-error" role="alert">@flightError</div>
          }
          <form class="admin-list-tools" method="get" asp-controller="Home" asp-action="Admin" data-flight-search>
            <input type="hidden" name="routePage" value="@Model.RoutePage">
            <input type="hidden" name="routeSearch" value="@Model.RouteSearch">
            <input type="hidden" name="routeType" value="@Model.RouteTypeFilter">
            <input type="hidden" name="flightPage" value="1">
            <label class="admin-search"><i data-lucide="search" aria-hidden="true"></i><span class="admin-sr-only">Tìm chuyến bay</span><input type="search" name="flightSearch" value="@Model.FlightSearch" placeholder="Tìm số hiệu, chặng bay hoặc máy bay" data-flight-search-input></label>
            <label class="admin-select-label"><span class="admin-sr-only">Lọc trạng thái chuyến</span><select name="flightStatus" data-flight-status-filter><option value="">Tất cả trạng thái</option>@foreach (var status in AdminFlightStatus.Options)
              {
                <option value="@status.Value" selected="@(Model.FlightStatusFilter == status.Value)">@status.Label</option>
              }</select></label>
            <button class="admin-button admin-button-small" type="submit">Lọc</button>
            <span class="admin-result-count">@Model.FilteredFlightCount chuyến bay</span>
          </form>
          <div class="admin-table-panel"><table class="admin-table" id="flights-table">
            <thead><tr><th>Số hiệu</th><th>Hành trình</th><th>Khởi hành</th><th>Đến nơi</th><th>Máy bay</th><th>Trạng thái</th><th class="admin-actions-heading">Thao tác</th></tr></thead>
            <tbody>
              @foreach (var flight in Model.Flights)
              {
                <tr>
                  <td data-label="Số hiệu"><strong>@flight.FlightNumber</strong></td>
                  <td data-label="Hành trình">@flight.DepartureAirportCode <span class="admin-route-arrow">→</span> @flight.ArrivalAirportCode<span class="admin-cell-meta">@flight.DepartureCity → @flight.ArrivalCity</span></td>
                  <td data-label="Khởi hành">@flight.DepartureTime.ToString("dd/MM/yyyy") <span class="admin-cell-meta">@flight.DepartureTime.ToString("HH:mm")</span></td>
                  <td data-label="Đến nơi">@flight.ArrivalTime.ToString("dd/MM/yyyy") <span class="admin-cell-meta">@flight.ArrivalTime.ToString("HH:mm")</span></td>
                  <td data-label="Máy bay">@flight.AircraftModel</td>
                  <td data-label="Trạng thái"><span class="admin-badge @AdminFlightStatus.BadgeClassFor(flight.Status)">@AdminFlightStatus.LabelFor(flight.Status)</span></td>
                  <td data-label="Thao tác"><div class="admin-row-actions">
                    <button class="admin-button admin-button-small" type="button" data-flight-edit
                            data-id="@flight.FlightId" data-number="@flight.FlightNumber"
                            data-route-id="@flight.RouteId"
                            data-departure="@flight.DepartureTime.ToString("yyyy-MM-ddTHH:mm")"
                            data-arrival="@flight.ArrivalTime.ToString("yyyy-MM-ddTHH:mm")"
                            data-aircraft-id="@flight.AircraftId" data-status="@flight.Status">Sửa</button>
                    <button class="admin-button admin-button-small admin-button-ghost admin-button-row-danger" type="button" data-flight-delete
                            data-id="@flight.FlightId" data-number="@flight.FlightNumber"
                            data-route="@flight.DepartureAirportCode → @flight.ArrivalAirportCode"
                            data-departure="@flight.DepartureTime.ToString("dd/MM/yyyy HH:mm")">Xóa</button>
                  </div></td>
                </tr>
              }
              @if (Model.Flights.Count == 0)
              {
                <tr><td colspan="7" class="admin-empty-row">
                  @if (!string.IsNullOrEmpty(Model.FlightSearch) || !string.IsNullOrEmpty(Model.FlightStatusFilter))
                  {
                    @:Không có chuyến bay khớp với bộ lọc hiện tại.
                    <a class="admin-empty-link" href="@ClearFlightFiltersUrl()">Xóa bộ lọc</a>
                  }
                  else
                  {
                    @:Chưa có chuyến bay nào.
                  }
                </td></tr>
              }
            </tbody>
          </table>
            <div class="admin-table-footer">
              <span>
                @if (Model.FilteredFlightCount == 0)
                {
                  @:Không có chuyến bay
                }
                else
                {
                  var firstFlight = (Model.FlightPage - 1) * AdminDashboardViewModelBuilder.FlightPageSize + 1;
                  var lastFlight = Math.Min(Model.FlightPage * AdminDashboardViewModelBuilder.FlightPageSize, Model.FilteredFlightCount);
                  @:Hiển thị @firstFlight–@lastFlight trên @Model.FilteredFlightCount chuyến bay
                }
              </span>
              @if (Model.FlightPageCount > 1)
              {
                <nav class="admin-pagination" aria-label="Phân trang chuyến bay">
                  @if (Model.FlightPage > 1)
                  {
                    <a href="@FlightPageUrl(Model.FlightPage - 1)" aria-label="Trang trước">‹</a>
                  }
                  else
                  {
                    <span aria-disabled="true">‹</span>
                  }
                  @for (var flightPageNumber = Math.Max(1, Model.FlightPage - 2); flightPageNumber <= Math.Min(Model.FlightPageCount, Model.FlightPage + 2); flightPageNumber++)
                  {
                    if (flightPageNumber == Model.FlightPage)
                    {
                      <span aria-current="page">@flightPageNumber</span>
                    }
                    else
                    {
                      <a href="@FlightPageUrl(flightPageNumber)">@flightPageNumber</a>
                    }
                  }
                  @if (Model.FlightPage < Model.FlightPageCount)
                  {
                    <a href="@FlightPageUrl(Model.FlightPage + 1)" aria-label="Trang sau">›</a>
                  }
                  else
                  {
                    <span aria-disabled="true">›</span>
                  }
                </nav>
              }
            </div>
          </div>
        </section>

        <section class="admin-screen" data-screen-panel="aircraft" hidden>
          <div class="admin-page-heading admin-aircraft-heading">
            <div><h1>Máy bay &amp; sơ đồ ghế</h1><p>Xem cấu hình máy bay và phân bố hạng ghế.</p></div>
            <div class="admin-page-actions">
              <button class="admin-button admin-button-outline" type="button" data-aircraft-open="edit"
                      data-aircraft-model="@(selectedAircraft?.Model ?? "")"
                      aria-haspopup="dialog" aria-controls="aircraft-dialog"
                      disabled="@(selectedAircraft is null)">Sửa model</button>
              <button class="admin-button admin-button-primary" type="button" data-aircraft-open="create"
                      aria-haspopup="dialog" aria-controls="aircraft-dialog">
                <i data-lucide="plus" aria-hidden="true"></i>Thêm máy bay
              </button>
            </div>
          </div>
          <div class="admin-aircraft-layout">
            <section class="admin-panel admin-aircraft-list">
              <header class="admin-panel-heading">
                <div><h2>Danh sách máy bay</h2><p>@Model.Aircrafts.Count máy bay trong đội</p></div>
              </header>
              <div class="admin-aircraft-options" role="group" aria-label="Chọn máy bay">
                @if (Model.Aircrafts.Count == 0)
                {
                  <div class="admin-aircraft-empty">
                    <i data-lucide="plane" aria-hidden="true"></i>
                    <strong>Chưa có máy bay</strong>
                    <span>Thêm máy bay để tạo sơ đồ ghế.</span>
                  </div>
                }
                else
                {
                  @foreach (var aircraft in Model.Aircrafts)
                  {
                    <a class="admin-aircraft-option" href="@AircraftPageUrl(aircraft.AircraftId)"
                       aria-current="@(aircraft.AircraftId == Model.SelectedAircraftId ? "page" : null)">
                      <span class="admin-aircraft-icon"><i data-lucide="plane" aria-hidden="true"></i></span>
                      <span><strong>@aircraft.Model</strong><small>@aircraft.TotalSeats.ToString("N0") ghế</small></span>
                      <i data-lucide="chevron-right" aria-hidden="true"></i>
                    </a>
                  }
                }
              </div>
            </section>
            <section class="admin-panel admin-seat-panel">
              @if (selectedAircraft is null)
              {
                <header class="admin-panel-heading admin-seat-heading">
                  <div><h2>Sơ đồ ghế</h2><p>Chọn máy bay để xem cấu hình ghế.</p></div>
                  <span class="admin-muted-pill">Chỉ xem</span>
                </header>
                <div class="admin-aircraft-empty admin-aircraft-empty-large">
                  <i data-lucide="armchair" aria-hidden="true"></i>
                  <strong>Chưa có sơ đồ ghế</strong>
                  <span>Thêm máy bay để tạo các hàng ghế.</span>
                </div>
              }
              else
              {
                <header class="admin-panel-heading admin-seat-heading">
                  <div>
                    <h2>@selectedAircraft.Model</h2>
                    <p>@Model.AircraftSeatRows.Sum(row => row.Seats.Count).ToString("N0") ghế · sơ đồ theo dữ liệu</p>
                  </div>
                  <span class="admin-muted-pill">Ghế · Chỉ xem</span>
                </header>
                @if (Model.AircraftSeatRows.SelectMany(row => row.Seats)
                    .Any(seat => seat.SeatClass.Equals("Business", StringComparison.OrdinalIgnoreCase)) ||
                    Model.AircraftSeatRows.SelectMany(row => row.Seats)
                    .Any(seat => seat.SeatClass.Equals("Economy", StringComparison.OrdinalIgnoreCase)))
                {
                  <div class="admin-seat-legend">
                    @if (Model.AircraftSeatRows.SelectMany(row => row.Seats)
                        .Any(seat => seat.SeatClass.Equals("Business", StringComparison.OrdinalIgnoreCase)))
                    {
                      <span><i class="admin-seat-dot admin-seat-dot-business"></i>Thương gia</span>
                    }
                    @if (Model.AircraftSeatRows.SelectMany(row => row.Seats)
                        .Any(seat => seat.SeatClass.Equals("Economy", StringComparison.OrdinalIgnoreCase)))
                    {
                      <span><i class="admin-seat-dot"></i>Phổ thông</span>
                    }
                  </div>
                }
                @if (Model.AircraftSeatRows.Count == 0)
                {
                  <div class="admin-aircraft-empty admin-aircraft-empty-large">
                    <i data-lucide="armchair" aria-hidden="true"></i>
                    <strong>Máy bay chưa có ghế</strong>
                    <span>Các ghế sẽ xuất hiện ở đây khi được thêm vào bảng Seats.</span>
                  </div>
                }
                else
                {
                  <div class="admin-seat-map-wrap">
                    <div class="admin-seat-map" role="group" aria-label="Sơ đồ ghế @selectedAircraft.Model">
                      @foreach (var row in Model.AircraftSeatRows)
                      {
                        <span class="admin-seat-row-label">@row.RowNumber</span>
                        @foreach (var column in seatColumns.Take(3))
                        {
                          var seat = row.Seats.FirstOrDefault(item =>
                              item.Column.Equals(column, StringComparison.OrdinalIgnoreCase));
                          if (seat is null)
                          {
                            <span class="admin-seat-placeholder" aria-hidden="true"></span>
                          }
                          else
                          {
                            var isBusiness = seat.SeatClass.Equals("Business", StringComparison.OrdinalIgnoreCase);
                            var seatClassLabel = isBusiness ? "Thương gia" :
                                seat.SeatClass.Equals("Economy", StringComparison.OrdinalIgnoreCase) ? "Phổ thông" : seat.SeatClass;
                            <span class="admin-seat @(isBusiness ? "admin-seat-business" : "")"
                                  role="img" aria-label="Ghế @seat.SeatNumber, @seatClassLabel">@seat.SeatNumber</span>
                          }
                        }
                        <span class="admin-seat-aisle" aria-hidden="true"></span>
                        @foreach (var column in seatColumns.Skip(3))
                        {
                          var seat = row.Seats.FirstOrDefault(item =>
                              item.Column.Equals(column, StringComparison.OrdinalIgnoreCase));
                          if (seat is null)
                          {
                            <span class="admin-seat-placeholder" aria-hidden="true"></span>
                          }
                          else
                          {
                            var isBusiness = seat.SeatClass.Equals("Business", StringComparison.OrdinalIgnoreCase);
                            var seatClassLabel = isBusiness ? "Thương gia" :
                                seat.SeatClass.Equals("Economy", StringComparison.OrdinalIgnoreCase) ? "Phổ thông" : seat.SeatClass;
                            <span class="admin-seat @(isBusiness ? "admin-seat-business" : "")"
                                  role="img" aria-label="Ghế @seat.SeatNumber, @seatClassLabel">@seat.SeatNumber</span>
                          }
                        }
                        @foreach (var seat in row.Seats.Where(item =>
                            !seatColumns.Contains(item.Column, StringComparer.OrdinalIgnoreCase)))
                        {
                          var seatClassLabel = seat.SeatClass.Equals("Business", StringComparison.OrdinalIgnoreCase) ? "Thương gia" :
                              seat.SeatClass.Equals("Economy", StringComparison.OrdinalIgnoreCase) ? "Phổ thông" : seat.SeatClass;
                          <span class="admin-seat" role="img" aria-label="Ghế @seat.SeatNumber, @seatClassLabel">@seat.SeatNumber</span>
                        }
                      }
                    </div>
                  </div>
                }
              }
            </section>
          </div>
        </section>

        <section class="admin-screen" data-screen-panel="pricing" hidden>
          <div class="admin-page-heading">
            <div><h1>Bảng giá</h1><p>Giá cơ bản, thuế và phí theo chuyến, hạng ghế và loại khách.</p></div>
            <div class="admin-heading-actions">
              <a class="admin-button admin-button-outline" asp-controller="FlightPricings" asp-action="Export">
                <i data-lucide="download" aria-hidden="true"></i>Xuất Excel
              </a>
              <button class="admin-button admin-button-primary" type="button" data-pricing-create
                      aria-haspopup="dialog" aria-controls="pricing-create-dialog"
                      disabled="@(Model.AvailablePricingFlights.Count == 0)">
                <i data-lucide="plus" aria-hidden="true"></i>Thêm mức giá
              </button>
            </div>
          </div>
          <section class="admin-panel admin-pricing-context">
            @if (Model.SelectedPricingFlight is { } selectedPricingFlight)
            {
              <div class="admin-pricing-flight">
                <span class="admin-metric-icon"><i data-lucide="plane" aria-hidden="true"></i></span>
                <div>
                  <strong>@selectedPricingFlight.FlightNumber · @selectedPricingFlight.DepartureAirportCode → @selectedPricingFlight.ArrivalAirportCode</strong>
                  <span>@selectedPricingFlight.DepartureTime.ToString("dd/MM/yyyy · HH:mm") · @selectedPricingFlight.AircraftModel</span>
                </div>
              </div>
            }
            else
            {
              <div class="admin-pricing-flight">
                <span class="admin-metric-icon"><i data-lucide="plane" aria-hidden="true"></i></span>
                <div><strong>Chưa có bảng giá</strong><span>Chọn chuyến bay chưa có giá để tạo bảng giá đầu tiên.</span></div>
              </div>
            }
            <form class="admin-select-label" method="get" asp-controller="Home" asp-action="Admin">
              <input type="hidden" name="routePage" value="@Model.RoutePage">
              <input type="hidden" name="flightPage" value="@Model.FlightPage">
              <label for="pricing-flight-select">Chuyến bay</label>
              <select id="pricing-flight-select" name="pricingFlightId" aria-label="Chọn chuyến bay có bảng giá"
                      onchange="this.form.submit()" disabled="@(Model.PricingFlights.Count == 0)">
                @if (Model.PricingFlights.Count == 0)
                {
                  <option value="">Chưa có chuyến bay nào được định giá</option>
                }
                else
                {
                  @foreach (var flight in Model.PricingFlights)
                  {
                    <option value="@flight.FlightId" selected="@(flight.FlightId == Model.SelectedPricingFlight?.FlightId)">
                      @flight.FlightNumber · @flight.DepartureAirportCode – @flight.ArrivalAirportCode
                    </option>
                  }
                }
              </select>
            </form>
          </section>
          @if (Model.FlightPricingRows.Count == 0)
          {
            <div class="admin-panel admin-pricing-empty" role="status">
              <i data-lucide="badge-dollar-sign" aria-hidden="true"></i>
              <strong>Chuyến bay này chưa có mức giá</strong>
              <span>Thêm đủ các mức giá để chuyến bay xuất hiện trong danh sách.</span>
            </div>
          }
          else
          {
            <div class="admin-table-panel admin-pricing-table">
              <table class="admin-table" id="pricing-table">
                <thead><tr><th>Hạng ghế</th><th>Loại khách</th><th>Giá cơ bản</th><th>Thuế</th><th>Phí dịch vụ</th><th>Tổng giá</th><th class="admin-actions-heading">Thao tác</th></tr></thead>
                @foreach (var group in pricingSeatClassGroups)
                {
                  var categoryLabel = SeatClassLabel(group.Key);
                  <tbody>
                    <tr class="admin-pricing-group-row">
                      <td colspan="7">
                        <button class="admin-pricing-group-toggle" type="button" data-pricing-toggle
                                aria-expanded="true" aria-label="Thu gọn mức giá hạng @categoryLabel">
                          <span>@categoryLabel</span>
                          <span class="admin-pricing-group-count">@group.Count() mức giá</span>
                          <i data-lucide="chevron-down" aria-hidden="true"></i>
                        </button>
                      </td>
                    </tr>
                    @foreach (var price in group)
                    {
                      <tr class="admin-pricing-row" data-pricing-row>
                        <td data-label="Hạng ghế"><strong>@categoryLabel</strong></td>
                        <td data-label="Loại khách">@PassengerTypeLabel(price.PassengerType)</td>
                        <td data-label="Giá cơ bản">@Money(price.BasePrice)</td>
                        <td data-label="Thuế">@Money(price.TaxAmount)</td>
                        <td data-label="Phí dịch vụ">@Money(price.ServiceFee)</td>
                        <td data-label="Tổng giá"><strong>@Money(price.TotalPrice)</strong></td>
                        <td data-label="Thao tác">
                          <button class="admin-button admin-button-small" type="button" data-pricing-edit
                                  data-price-id="@price.PriceId"
                                  data-seat-class="@categoryLabel"
                                  data-passenger-type="@PassengerTypeLabel(price.PassengerType)"
                                  data-base-price="@price.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  data-tax-amount="@price.TaxAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                  data-service-fee="@price.ServiceFee.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            Sửa
                          </button>
                        </td>
                      </tr>
                    }
                  </tbody>
                }
              </table>
            </div>
          }
        </section>

        <section class="admin-screen" data-screen-panel="promotions" hidden>
          <div class="admin-page-heading">
            <div><h1>Khuyến mãi</h1><p>Quản lý mã giảm giá, điều kiện áp dụng và lượt sử dụng.</p></div>
            <div class="admin-heading-actions"><a class="admin-button admin-button-outline" asp-controller="Promotions" asp-action="Export"><i data-lucide="download" aria-hidden="true"></i>Xuất Excel</a><button class="admin-button admin-button-primary" type="button" data-promotion-create><i data-lucide="plus" aria-hidden="true"></i>Thêm mã</button></div>
          </div>
          @if (TempData["PromotionSuccess"] is string promotionSuccess)
          {
            <p class="admin-inline-notice admin-inline-notice-success" role="status">@promotionSuccess</p>
          }
          @if (TempData["PromotionError"] is string promotionError)
          {
            <p class="admin-inline-notice admin-inline-notice-error" role="alert">@promotionError</p>
          }
          <form class="admin-list-tools" method="get" action="@Url.Action("Admin", "Home")#promotions" data-promotion-filter>
            <label class="admin-search"><i data-lucide="search" aria-hidden="true"></i><span class="admin-sr-only">Tìm mã khuyến mãi</span><input type="search" name="promotionSearch" value="@Model.PromotionSearch" placeholder="Tìm mã khuyến mãi"></label>
            <label class="admin-select-label"><span class="admin-sr-only">Lọc trạng thái khuyến mãi</span><select name="promotionStatus" data-promotion-status>
              <option value="">Tất cả trạng thái</option>
              <option value="active" selected="@(Model.PromotionStatusFilter == "active")">Đang áp dụng</option>
              <option value="upcoming" selected="@(Model.PromotionStatusFilter == "upcoming")">Sắp diễn ra</option>
              <option value="exhausted" selected="@(Model.PromotionStatusFilter == "exhausted")">Hết lượt</option>
              <option value="expired" selected="@(Model.PromotionStatusFilter == "expired")">Đã kết thúc</option>
            </select></label>
            <span class="admin-result-count">@Model.FilteredPromotionCount mã khuyến mãi</span>
          </form>
          <div class="admin-table-panel"><table class="admin-table admin-promo-table" id="promotions-table">
            <thead><tr><th>Mã</th><th>Hình thức</th><th>Đơn tối thiểu</th><th>Thời hạn</th><th>Lượt dùng</th><th>Trạng thái</th><th class="admin-actions-heading">Thao tác</th></tr></thead>
            <tbody>
              @if (Model.Promotions.Count == 0)
              {
                <tr><td class="admin-empty-row" colspan="7">@(Model.FilteredPromotionCount == 0 && string.IsNullOrEmpty(Model.PromotionSearch) && string.IsNullOrEmpty(Model.PromotionStatusFilter) ? "Chưa có mã khuyến mãi." : "Không tìm thấy mã khuyến mãi phù hợp.")</td></tr>
              }
              @foreach (var promotion in Model.Promotions)
              {
                var discountLabel = promotion.DiscountPercent is decimal percent
                    ? $"{percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%"
                    : $"{promotion.DiscountAmount?.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ?? "0"} ₫";
                var statusLabel = promotion.Status switch
                {
                    "active" => "Đang áp dụng",
                    "upcoming" => "Sắp diễn ra",
                    "exhausted" => "Hết lượt",
                    _ => "Đã kết thúc"
                };
                var statusClass = promotion.Status switch
                {
                    "active" => "admin-badge-success",
                    "upcoming" => "admin-badge-info",
                    "exhausted" => "admin-badge-warning",
                    _ => "admin-badge-warning"
                };
                <tr>
                  <td data-label="Mã"><strong class="admin-code">@promotion.Code</strong></td>
                  <td data-label="Hình thức">@discountLabel@if (promotion.PointsRequired is int requiredPoints){<span> · @requiredPoints điểm</span>}</td>
                  <td data-label="Đơn tối thiểu">@(promotion.MinOrderValue is > 0 ? $"{promotion.MinOrderValue.Value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))} ₫" : "Không yêu cầu")</td>
                  <td data-label="Thời hạn">@promotion.StartDate.ToString("dd/MM/yyyy") – @promotion.EndDate.ToString("dd/MM/yyyy")</td>
                  <td data-label="Lượt dùng">@promotion.UsedCount / @promotion.UsageLimit</td>
                  <td data-label="Trạng thái"><span class="admin-badge @statusClass">@statusLabel</span></td>
                  <td data-label="Thao tác">
                    <button class="admin-button admin-button-small" type="button"
                            data-promotion-edit
                            data-promo-id="@promotion.PromoId"
                            data-code="@promotion.Code"
                            data-discount-percent="@promotion.DiscountPercent?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-discount-amount="@promotion.DiscountAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-min-order-value="@promotion.MinOrderValue?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-points-required="@promotion.PointsRequired"
                            data-start-date="@promotion.StartDate.ToString("yyyy-MM-dd")"
                            data-end-date="@promotion.EndDate.ToString("yyyy-MM-dd")"
                            data-usage-limit="@promotion.UsageLimit">Sửa</button>
                  </td>
                </tr>
              }
            </tbody>
          </table></div>
          <p class="admin-footnote">Mã khuyến mãi chỉ có thao tác thêm và sửa; không có chức năng xóa.</p>
        </section>
      </div>
    </main>
  </div>

  <dialog class="admin-dialog" id="route-dialog" aria-labelledby="route-dialog-title"
          data-open="@Model.OpenRouteDialog.ToString().ToLowerInvariant()"
          data-mode="@Model.RouteDialogMode">
    <form class="admin-dialog-form" method="post" asp-controller="Routes" asp-action="Create"
          data-route-form
          data-create-url="@Url.Action("Create", "Routes")"
          data-edit-url="@Url.Action("Edit", "Routes")">
      <header class="admin-dialog-heading">
        <div><h2 id="route-dialog-title">Thêm tuyến bay</h2><p>Chọn sân bay khởi hành, điểm đến và loại tuyến.</p></div>
        <button class="admin-icon-button" type="button" data-route-dialog-close aria-label="Đóng cửa sổ"><i data-lucide="x" aria-hidden="true"></i></button>
      </header>
      <div class="admin-validation-summary" asp-validation-summary="All" role="alert"></div>
      <div class="admin-dialog-fields">
        <div class="admin-field">
          <label asp-for="RouteInput.DepartureAirportCode">Sân bay đi</label>
          <select asp-for="RouteInput.DepartureAirportCode" required>
            <option value="">Chọn sân bay đi</option>
            @foreach (var airport in Model.Airports)
            {
              <option value="@airport.AirportCode">@airport.AirportCode · @airport.City</option>
            }
          </select>
          <span asp-validation-for="RouteInput.DepartureAirportCode" class="admin-validation-message"></span>
        </div>
        <div class="admin-field">
          <label asp-for="RouteInput.ArrivalAirportCode">Sân bay đến</label>
          <select asp-for="RouteInput.ArrivalAirportCode" required>
            <option value="">Chọn sân bay đến</option>
