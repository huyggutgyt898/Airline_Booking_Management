  <dialog class="admin-dialog admin-pricing-dialog" id="pricing-create-dialog"
          aria-labelledby="pricing-create-title"
          data-open="@Model.OpenFlightPricingDialog.ToString().ToLowerInvariant()">
    <form class="admin-dialog-form" method="post" asp-controller="FlightPricings" asp-action="Create">
      <header class="admin-dialog-heading">
        <div>
          <h2 id="pricing-create-title">Thêm bảng giá chuyến bay</h2>
          <p>Chọn chuyến bay chưa có giá và nhập đủ sáu tổ hợp giá.</p>
        </div>
        <button class="admin-icon-button" type="button" data-pricing-dialog-close aria-label="Đóng cửa sổ">
          <i data-lucide="x" aria-hidden="true"></i>
        </button>
      </header>
      <div class="admin-validation-summary" asp-validation-summary="All" role="alert"></div>
      <input type="hidden" name="selectedPricingFlightId" value="@Model.SelectedPricingFlight?.FlightId">
      <div class="admin-pricing-create-flight admin-field">
        <label asp-for="FlightPricingInput.FlightId">Chuyến bay</label>
        <select asp-for="FlightPricingInput.FlightId" required>
          <option value="">Chọn chuyến bay chưa có bảng giá</option>
          @foreach (var flight in Model.AvailablePricingFlights)
          {
            <option value="@flight.FlightId">
              @flight.FlightNumber · @flight.DepartureAirportCode – @flight.ArrivalAirportCode · @flight.DepartureTime.ToString("dd/MM/yyyy HH:mm") · @flight.AircraftModel
            </option>
          }
        </select>
        <span class="admin-validation-message" asp-validation-for="FlightPricingInput.FlightId"></span>
        @if (Model.AvailablePricingFlights.Count == 0)
        {
          <span class="admin-footnote">Hiện không còn chuyến bay chưa có bảng giá.</span>
        }
      </div>
      <div class="admin-pricing-input-wrap">
        <table class="admin-pricing-input-table">
          <thead>
            <tr><th>Hạng ghế</th><th>Loại khách</th><th>Giá cơ bản</th><th>Thuế</th><th>Phí dịch vụ</th></tr>
          </thead>
          <tbody>
            @for (var index = 0; index < Model.FlightPricingInput.Lines.Count; index++)
            {
              var line = Model.FlightPricingInput.Lines[index];
              <tr>
                <td>
                  <input type="hidden" asp-for="FlightPricingInput.Lines[index].SeatClass">
                  @(SeatClassLabel(line.SeatClass))
                </td>
                <td>
                  <input type="hidden" asp-for="FlightPricingInput.Lines[index].PassengerType">
                  @(PassengerTypeLabel(line.PassengerType))
                </td>
                <td>
                  <input asp-for="FlightPricingInput.Lines[index].BasePrice" type="number" min="0" step="0.01" required aria-label="Giá cơ bản @SeatClassLabel(line.SeatClass) @PassengerTypeLabel(line.PassengerType)">
                </td>
                <td>
                  <input asp-for="FlightPricingInput.Lines[index].TaxAmount" type="number" min="0" step="0.01" required aria-label="Thuế @SeatClassLabel(line.SeatClass) @PassengerTypeLabel(line.PassengerType)">
                </td>
                <td>
                  <input asp-for="FlightPricingInput.Lines[index].ServiceFee" type="number" min="0" step="0.01" required aria-label="Phí dịch vụ @SeatClassLabel(line.SeatClass) @PassengerTypeLabel(line.PassengerType)">
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
      <footer class="admin-dialog-actions">
        <button class="admin-button admin-button-outline" type="button" data-pricing-dialog-close>Hủy</button>
        <button class="admin-button admin-button-primary" type="submit">Lưu bảng giá</button>
      </footer>
    </form>
  </dialog>

