@model TEO_Airline_Project.Models.ViewModels.StaffProfileViewModel
@{
    Layout = null;
    var fullName = Model.FullName;
    var staffCode = $"NV-{Model.UserId:D4}";
    var initials = string.Concat(
        fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .TakeLast(2)
            .Select(part => char.ToUpperInvariant(part[0])));
}
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0F766E">
  <meta name="description" content="Giao diện nghiệp vụ nhân viên quầy vé TEO Airlines.">
  <title>Đặt vé tại quầy — TEO Airlines</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
  <link rel="stylesheet" href="~/css/style.css">
  <link rel="stylesheet" href="~/css/counter.css">
</head>
<body class="counter-page">
  <button class="counter-scrim" type="button" data-menu-close aria-label="Đóng menu" hidden></button>
  <div class="counter-shell">
    <aside class="counter-sidebar" id="counter-sidebar" aria-label="Điều hướng nhân viên">
      <a class="counter-brand" asp-controller="Home" asp-action="Counter" asp-route-screen="booking" aria-label="TEO Airlines — Đặt vé tại quầy">
        <span class="counter-brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.8 3.2c-.9-.9-2.2-.4-3.1.5l-4.3 4.3-7.8-2c-.5-.1-1 .1-1.4.4l-.9.9 5.7 3.2-3.1 3.1-2.8-.7L2 14l3.7 1.8L7.5 19l1.1-1.1-.7-2.8 3.1-3.1 3.2 5.7.9-.9c.4-.4.5-.9.4-1.4l-2-7.8 4.3-4.3c.9-.9 1.4-2.2.5-3.1z"></path></svg>
        </span>
        <span class="counter-brand-copy"><strong>TEO</strong><span>Airlines · Quầy vé</span></span>
      </a>

      <p class="counter-nav-label">Nghiệp vụ</p>
      <nav class="counter-nav" aria-label="Nghiệp vụ quầy vé">
        <a class="counter-nav-link" asp-controller="Home" asp-action="Counter" asp-route-screen="booking" data-screen-link="booking"><i data-lucide="ticket" aria-hidden="true"></i>Đặt vé</a>
        <a class="counter-nav-link" asp-controller="Home" asp-action="Counter" asp-route-screen="exchange" data-screen-link="exchange"><i data-lucide="refresh-ccw" aria-hidden="true"></i>Đổi / hủy vé</a>
        <a class="counter-nav-link" asp-controller="Home" asp-action="Counter" asp-route-screen="customers" data-screen-link="customers"><i data-lucide="users-round" aria-hidden="true"></i>Tài khoản khách</a>
      </nav>
      <p class="counter-nav-label counter-nav-label-personal">Cá nhân</p>
      <nav class="counter-nav" aria-label="Thông tin cá nhân">
        <a class="counter-nav-link" asp-controller="Home" asp-action="Counter" asp-route-screen="profile" data-screen-link="profile"><i data-lucide="user-round" aria-hidden="true"></i>Hồ sơ nhân viên</a>
      </nav>

      <div class="counter-sidebar-spacer"></div>
      <details class="counter-account-menu">
        <summary class="counter-agent">
          <span class="counter-avatar" aria-hidden="true">@initials</span>
          <span class="counter-agent-copy"><strong>@fullName</strong><span>Nhân viên quầy</span></span>
          <i data-lucide="chevron-up" aria-hidden="true"></i>
        </summary>
        <div class="counter-account-popover">
          <button class="counter-account-signout" type="button" data-signout-open><i data-lucide="log-out" aria-hidden="true"></i><span>Đăng xuất</span></button>
        </div>
      </details>
    </aside>

    <main class="counter-main">
      <header class="counter-topbar">
        <button class="counter-menu-toggle" type="button" data-menu-toggle aria-label="Mở menu" aria-controls="counter-sidebar" aria-expanded="false"><i data-lucide="menu" aria-hidden="true"></i></button>
        <p class="counter-breadcrumb">TEO Airlines <span aria-hidden="true">/</span> <strong data-page-title>Đặt vé</strong></p>
      </header>

      <section class="counter-view" data-screen="booking">
        <div id="counter-antiforgery" hidden>@Html.AntiForgeryToken()</div>
        <div class="counter-page-heading"><div><h1>Đặt vé tại quầy</h1><p>Tìm chuyến, chọn ghế và ghi nhận thanh toán.</p></div></div>
        <div class="counter-stepper" aria-label="Các bước đặt vé">
          <div class="counter-step is-current"><span>1</span>Chuyến bay</div>
          <div class="counter-step"><span>2</span>Hành khách</div>
          <div class="counter-step"><span>3</span>Chọn ghế</div>
          <div class="counter-step"><span>4</span>Thanh toán</div>
        </div>

        <div class="counter-booking-grid">
          <div class="counter-booking-main">
            <section class="counter-panel">
              <div class="counter-panel-head"><h2>Tìm chuyến bay</h2><span class="counter-small counter-muted">Một chiều · Nội địa</span></div>
              <div class="counter-panel-body">
                <div class="counter-field-grid counter-field-grid-two">
                  <div class="counter-field"><label for="origin">Điểm đi</label><select id="origin" required><option value="">Đang tải sân bay...</option></select></div>
                  <div class="counter-field"><label for="destination">Điểm đến</label><select id="destination" required><option value="">Đang tải sân bay...</option></select></div>
                  <div class="counter-field"><label for="departure">Ngày bay</label><input id="departure" type="date" required></div>
                  <div class="counter-field"><label for="cabin">Hạng ghế</label><select id="cabin"><option value="Economy">Phổ thông</option><option value="Business">Thương gia</option></select></div>
                </div>
                <p class="counter-booking-feedback" id="search-feedback" role="status" aria-live="polite" hidden></p>
                <div class="counter-actions"><button class="counter-button" type="button" id="reset-booking">Đặt lại</button><button class="counter-button counter-button-primary" type="button" id="search-flights"><i data-lucide="search" aria-hidden="true"></i>Tìm chuyến</button></div>
              </div>
            </section>

            <section class="counter-panel">
              <div class="counter-panel-head"><h2>Chuyến phù hợp</h2><span class="counter-small counter-muted" id="flight-count">Chưa tìm chuyến</span></div>
              <div class="counter-table-wrap">
                <table class="counter-table">
                  <thead><tr><th>Chuyến bay</th><th>Khởi hành</th><th>Đến nơi</th><th>Ghế còn</th><th>Giá / khách</th><th></th></tr></thead>
                  <tbody id="flight-results"><tr><td colspan="6" class="counter-empty-cell">Nhập hành trình và nhấn “Tìm chuyến”.</td></tr></tbody>
                </table>
              </div>
              <div class="counter-flight-list" id="flight-cards" aria-label="Danh sách chuyến bay"></div>
            </section>

            <section class="counter-panel">
              <div class="counter-panel-head"><h2>Hành khách và ghế</h2><span class="counter-small counter-muted" id="selected-flight-label">Chọn chuyến bay trước</span></div>
              <div class="counter-panel-body">
                <div class="counter-field-grid counter-field-grid-two">
                  <div class="counter-field"><label for="passenger-name">Họ tên hành khách</label><input id="passenger-name" maxlength="100" autocomplete="name" required></div>
                  <div class="counter-field"><label for="passenger-gender">Giới tính</label><select id="passenger-gender"><option value="Male">Nam</option><option value="Female">Nữ</option><option value="Other">Khác</option></select></div>
                  <div class="counter-field"><label for="passenger-dob">Ngày sinh</label><input id="passenger-dob" type="date" required></div>
                  <div class="counter-field"><label for="passenger-id">CCCD / hộ chiếu</label><input id="passenger-id" maxlength="50" autocomplete="off" required></div>
                  <div class="counter-field"><label for="contact-name">Người liên hệ</label><input id="contact-name" maxlength="100" autocomplete="name" required></div>
                  <div class="counter-field"><label for="contact-phone">Số điện thoại liên hệ</label><input id="contact-phone" type="tel" maxlength="20" autocomplete="tel" required></div>
                  <div class="counter-field counter-field-full"><label for="contact-email">Email liên hệ</label><input id="contact-email" type="email" maxlength="100" autocomplete="email" required></div>
                </div>
                <p class="counter-small counter-muted counter-seat-label">Sơ đồ ghế</p>
                <p class="counter-small counter-muted" id="seat-map-message">Chọn chuyến bay để xem ghế còn trống.</p>
                <div class="counter-seat-map" id="seat-map" aria-label="Sơ đồ ghế"></div>
                <p class="counter-booking-feedback" id="booking-feedback" role="status" aria-live="polite" hidden></p>
              </div>
            </section>
          </div>

          <aside class="counter-panel counter-summary">
            <div class="counter-panel-head"><h2>Tóm tắt đặt chỗ</h2><span class="counter-badge counter-badge-brand" id="booking-status">Nháp</span></div>
            <div class="counter-panel-body">
              <div class="counter-route"><div><strong id="summary-origin">—</strong><span id="summary-departure">Chưa chọn</span></div><span class="counter-route-line"></span><div><strong id="summary-destination">—</strong><span id="summary-arrival">Chưa chọn</span></div></div>
              <div id="summary-lines"><div class="counter-summary-line"><span>Chọn chuyến bay và ghế</span><span>—</span></div></div>
              <div class="counter-summary-total"><span>Tổng cộng</span><strong id="summary-total">—</strong></div>
              <fieldset class="counter-payment-options">
                <legend class="counter-small counter-muted">Phương thức thu tiền</legend>
                <label class="counter-payment-option is-selected"><input type="radio" name="payment" value="Cash" checked><span>Tiền mặt</span></label>
                <label class="counter-payment-option"><input type="radio" name="payment" value="Transfer"><span>Chuyển khoản</span></label>
              </fieldset>
              <button class="counter-button counter-button-primary counter-payment-submit" type="button" id="confirm-counter-booking" disabled>Xác nhận thanh toán</button>
              <p class="counter-small counter-muted counter-demo-note">Xác nhận sẽ ghi nhận thanh toán và phát hành vé trong CSDL.</p>
            </div>
          </aside>
        </div>
      </section>

      <section class="counter-view" data-screen="exchange" hidden>
        <div class="counter-page-heading"><div><h1>Đổi / hủy vé</h1><p>Tra cứu vé thật, kiểm tra điều kiện và ghi nhận xử lý tại quầy.</p></div></div>
        <form class="counter-panel" id="ticket-search-form">
          <div class="counter-panel-head"><h2>Tra cứu vé</h2><span class="counter-small counter-muted">Cần mã đặt chỗ và tên hoặc thông tin liên hệ</span></div>
          <div class="counter-panel-body">
            <div class="counter-field-grid">
              <div class="counter-field"><label for="booking-code">Mã đặt chỗ</label><input id="booking-code" name="bookingCode" autocomplete="off" required maxlength="10"></div>
              <div class="counter-field"><label for="lookup-name">Tên hành khách</label><input id="lookup-name" name="passengerName" autocomplete="off" maxlength="100"></div>
              <div class="counter-field"><label for="lookup-contact">Số điện thoại / email</label><input id="lookup-contact" name="contact" autocomplete="off" maxlength="100"></div>
              <div class="counter-field"><label for="lookup-date">Ngày bay (không bắt buộc)</label><input id="lookup-date" name="flightDate" type="date"></div>
            </div>
            <p class="counter-booking-feedback" id="ticket-search-feedback" role="status" aria-live="polite" hidden></p>
            <div class="counter-actions">
              <button class="counter-button" type="reset">Xóa điều kiện</button>
              <button class="counter-button counter-button-primary" type="submit" id="ticket-search-submit"><i data-lucide="search" aria-hidden="true"></i>Tra cứu</button>
            </div>
          </div>
        </form>

        <div class="counter-lookup-grid">
          <section class="counter-panel" aria-labelledby="ticket-results-title">
            <div class="counter-panel-head"><h2 id="ticket-results-title">Vé tìm thấy</h2><span class="counter-small counter-muted" id="ticket-result-count">Chưa tra cứu</span></div>
            <div class="counter-table-wrap">
              <table class="counter-table">
                <thead><tr><th>Mã vé</th><th>Hành khách</th><th>Hành trình</th><th>Khởi hành</th><th>Trạng thái</th></tr></thead>
                <tbody id="ticket-results"><tr><td colspan="5" class="counter-empty-cell">Nhập mã đặt chỗ và thông tin xác minh để bắt đầu.</td></tr></tbody>
              </table>
            </div>
            <div class="counter-booking-cards" id="ticket-result-cards"></div>
          </section>

          <aside class="counter-panel" id="ticket-detail" hidden aria-labelledby="ticket-detail-title">
            <div class="counter-panel-head"><h2 id="ticket-detail-title">Chi tiết vé</h2><span class="counter-badge" id="ticket-status"></span></div>
            <div class="counter-panel-body">
              <strong class="counter-link" id="ticket-number"></strong>
              <p class="counter-record-meta" id="ticket-booking"></p>
              <div class="counter-route counter-route-detail">
                <div><strong id="ticket-origin"></strong><span id="ticket-departure"></span></div>
                <span class="counter-route-line"></span>
                <div><strong id="ticket-destination"></strong><span id="ticket-arrival"></span></div>
              </div>
              <dl class="counter-detail-list">
                <dt>Hành khách</dt><dd id="ticket-passenger"></dd>
                <dt>Liên hệ</dt><dd id="ticket-contact"></dd>
                <dt>Chuyến bay</dt><dd id="ticket-flight"></dd>
                <dt>Ghế / hạng</dt><dd id="ticket-seat"></dd>
                <dt>Giá vé gốc</dt><dd id="ticket-fare"></dd>
                <dt>Thuế / phí dịch vụ</dt><dd id="ticket-taxes"></dd>
                <dt>Đã thanh toán phân bổ</dt><dd id="ticket-paid"></dd>
              </dl>
              <section class="counter-policy" aria-labelledby="ticket-policy-title">
                <h3 id="ticket-policy-title">Điều kiện áp dụng</h3>
                <ul>
                  <li>Đổi trước giờ khởi hành ít nhất 5 ngày; thu phụ phí 10% giá vé gốc và phần chênh lệch (nếu có).</li>
                  <li>Hủy trước giờ khởi hành ít nhất 12 tiếng.</li>
                  <li>Hủy trước hơn 3 ngày: hoàn đủ phần tiền đã thanh toán phân bổ cho vé; còn lại hoàn 5% giá vé gốc.</li>
                </ul>
              </section>
              <div class="counter-adjustment-summary" aria-label="Ước tính đổi và hủy vé">
                <div><span>Phụ phí đổi</span><strong id="ticket-exchange-surcharge">—</strong></div>
                <div><span>Tiền hoàn dự kiến</span><strong id="ticket-refund-estimate">—</strong></div>
              </div>
              <p class="counter-booking-feedback" id="ticket-operation-feedback" role="status" aria-live="polite" hidden></p>
              <section class="counter-history" aria-labelledby="ticket-history-title">
                <h3 id="ticket-history-title">Lịch sử xử lý</h3>
                <div id="ticket-history"><p>Chưa có bản ghi.</p></div>
              </section>

              <form class="counter-ticket-action" id="ticket-exchange-form">
                <h3>Đổi chuyến</h3>
                <p class="counter-small counter-muted" id="exchange-eligibility"></p>
                <div class="counter-field">
                  <label for="exchange-flight">Chuyến mới · ghế gợi ý</label>
                  <select id="exchange-flight" name="newFlightId" required disabled><option value="">Chọn vé đủ điều kiện để tải chuyến</option></select>
                </div>
                <p class="counter-small counter-muted" id="exchange-amount"></p>
                <div class="counter-field">
                  <label for="exchange-reason">Lý do đổi</label>
                  <input id="exchange-reason" name="reason" required minlength="3" maxlength="500">
                </div>
                <label class="counter-confirm-check"><input id="exchange-payment-confirmed" type="checkbox" required><span>Tôi đã thu khoản tiền hiển thị tại quầy.</span></label>
                <button class="counter-button counter-button-primary" type="submit" id="ticket-exchange-submit" disabled>Đổi vé và ghi nhận thanh toán</button>
              </form>

              <form class="counter-ticket-action" id="ticket-cancel-form">
                <h3>Hủy vé</h3>
                <p class="counter-small counter-muted" id="cancel-eligibility"></p>
                <div class="counter-field">
                  <label for="cancel-reason">Lý do hủy</label>
                  <input id="cancel-reason" name="reason" required minlength="3" maxlength="500">
                </div>
                <label class="counter-confirm-check"><input id="cancel-refund-confirmed" type="checkbox" required><span>Tôi đã hoàn khoản tiền hiển thị cho khách.</span></label>
                <button class="counter-button counter-button-danger" type="submit" id="ticket-cancel-submit" disabled>Hủy vé và ghi nhận hoàn tiền</button>
              </form>
            </div>
          </aside>
        </div>
      </section>

      <section class="counter-view" data-screen="customers" hidden>
        <div class="counter-page-heading"><div><h1>Tài khoản khách hàng</h1><p>Tra cứu và quản lý tài khoản hành khách / khách hàng.</p></div></div>
        <div class="counter-account-grid">
          <section class="counter-panel">
            <div class="counter-panel-head"><h2>Danh sách tài khoản</h2><span class="counter-small counter-muted">1.284 tài khoản</span></div>
            <div class="counter-panel-body">
              <div class="counter-filters">
                <div class="counter-field"><label for="customer-search">Tìm khách hàng</label><input id="customer-search" value="Ngọc Hà, email hoặc số điện thoại"></div>
                <div class="counter-field counter-status-field"><label id="customer-status-label">Trạng thái</label><div class="counter-select">
                  <button class="counter-select-trigger" id="customer-status-trigger" type="button" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-controls="customer-status-listbox" aria-labelledby="customer-status-label customer-status-value" data-select-trigger><span id="customer-status-value">Tất cả</span><i data-lucide="chevron-down" aria-hidden="true"></i></button>
                  <div class="counter-select-menu" id="customer-status-listbox" role="listbox" aria-labelledby="customer-status-label" aria-hidden="true" inert><button class="counter-select-option" type="button" role="option" aria-selected="true">Tất cả<i data-lucide="check" aria-hidden="true"></i></button><button class="counter-select-option" type="button" role="option" aria-selected="false">Đang hoạt động</button><button class="counter-select-option" type="button" role="option" aria-selected="false">Đã khóa</button></div>
                </div></div>
                <button class="counter-button counter-button-primary" type="button" data-demo-action>Tìm kiếm</button>
              </div>
            </div>
            <div class="counter-table-wrap">
              <table class="counter-table">
                <thead><tr><th>Khách hàng</th><th>Liên hệ</th><th>Vai trò</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                  <tr class="is-selected"><td><div class="counter-account-cell"><span class="counter-customer-avatar">LH</span><span><strong>Lê Ngọc Hà</strong><span class="counter-record-meta">Tạo 12/06/2025</span></span></div></td><td>ha.le@example.vn<span class="counter-record-meta">0987 654 321</span></td><td>Hành khách</td><td><span class="counter-badge counter-badge-success">Hoạt động</span></td><td><button class="counter-button counter-button-sm" type="button" data-demo-action>Chi tiết</button></td></tr>
                  <tr><td><div class="counter-account-cell"><span class="counter-customer-avatar">PN</span><span><strong>Phạm Gia Nhi</strong><span class="counter-record-meta">Tạo 03/02/2026</span></span></div></td><td>nhi.pham@example.vn<span class="counter-record-meta">0908 112 233</span></td><td>Hành khách</td><td><span class="counter-badge counter-badge-danger">Đã khóa</span></td><td><button class="counter-button counter-button-sm" type="button" data-demo-action>Chi tiết</button></td></tr>
                  <tr><td><div class="counter-account-cell"><span class="counter-customer-avatar">TD</span><span><strong>Tên hành khách hiển thị dài để kiểm tra xuống dòng</strong><span class="counter-record-meta">Tài khoản tạo 18/10/2026</span></span></div></td><td>—<span class="counter-record-meta">000 000 000</span></td><td>Hành khách</td><td><span class="counter-badge counter-badge-success">Hoạt động</span></td><td><button class="counter-button counter-button-sm" type="button" data-demo-action>Chi tiết</button></td></tr>
                </tbody>
              </table>
            </div>
            <div class="counter-customer-cards">
              <article class="counter-customer-card is-selected"><div class="counter-customer-card-head"><div class="counter-account-cell"><span class="counter-customer-avatar">LH</span><strong>Lê Ngọc Hà</strong></div><span class="counter-badge counter-badge-success">Hoạt động</span></div><span>ha.le@example.vn · 0987 654 321</span><button class="counter-button counter-button-sm" type="button" data-demo-action>Chi tiết</button></article>
              <article class="counter-customer-card"><div class="counter-customer-card-head"><div class="counter-account-cell"><span class="counter-customer-avatar">PN</span><strong>Phạm Gia Nhi</strong></div><span class="counter-badge counter-badge-danger">Đã khóa</span></div><span>nhi.pham@example.vn · 0908 112 233</span><button class="counter-button counter-button-sm" type="button" data-demo-action>Chi tiết</button></article>
              <article class="counter-customer-card"><div class="counter-customer-card-head"><div class="counter-account-cell"><span class="counter-customer-avatar">TD</span><strong>Tên hành khách hiển thị dài để kiểm tra xuống dòng</strong></div><span class="counter-badge counter-badge-success">Hoạt động</span></div><span>— · 000 000 000</span><button class="counter-button counter-button-sm" type="button" data-demo-action>Chi tiết</button></article>
            </div>
          </section>

          <aside class="counter-panel">
            <div class="counter-panel-head"><h2>Thông tin tài khoản</h2><span class="counter-badge counter-badge-success">Hoạt động</span></div>
            <div class="counter-panel-body">
              <div class="counter-account-cell counter-account-detail"><span class="counter-customer-avatar">LH</span><span><strong>Lê Ngọc Hà</strong><span class="counter-record-meta">Vai trò hành khách</span></span></div>
              <dl class="counter-detail-list"><dt>Email</dt><dd>ha.le@example.vn</dd><dt>Điện thoại</dt><dd>0987 654 321</dd><dt>Ngày tạo</dt><dd>12/06/2025</dd><dt>Đặt chỗ</dt><dd>6 đặt chỗ</dd></dl>
              <div class="counter-notice"><i data-lucide="triangle-alert" aria-hidden="true"></i><span>Khóa tài khoản sẽ ngăn khách đăng nhập. Không ảnh hưởng dữ liệu đặt chỗ.</span></div>
              <button class="counter-button counter-button-danger counter-lock-button" type="button" data-open-confirm="lock"><i data-lucide="lock-keyhole" aria-hidden="true"></i>Khóa tài khoản</button>
            </div>
          </aside>
        </div>
      </section>

      <section class="counter-view" data-screen="profile" hidden>
        <div class="counter-page-heading"><div><h1>Hồ sơ nhân viên</h1><p>Cập nhật thông tin cá nhân và mật khẩu đăng nhập.</p></div></div>
        <div class="counter-profile-grid">
          <section class="counter-panel">
            <div class="counter-panel-head"><h2>Thông tin cá nhân</h2></div>
            <div class="counter-panel-body"><form class="counter-form-grid" asp-controller="Home" asp-action="SaveStaffProfile" asp-route-screen="profile" method="post">
              @Html.AntiForgeryToken()
              @if (!string.IsNullOrWhiteSpace(Model.ProfileMessage))
              {
                <p class="counter-profile-feedback counter-profile-feedback-success" role="status">@Model.ProfileMessage</p>
              }
              @if (!string.IsNullOrWhiteSpace(Model.ProfileError))
              {
                <p class="counter-profile-feedback counter-profile-feedback-error" role="alert">@Model.ProfileError</p>
              }
              <div class="counter-field"><label for="staff-name">Họ và tên</label><input id="staff-name" name="fullName" value="@Model.FullName" required maxlength="100" autocomplete="name"></div>
              <div class="counter-field"><label for="staff-id">Mã nhân viên</label><input id="staff-id" value="@staffCode" disabled></div>
              <div class="counter-field"><label for="staff-email">Email công việc</label><input id="staff-email" name="email" type="email" value="@Model.Email" required maxlength="100" autocomplete="email"></div>
              <div class="counter-field"><label for="staff-phone">Số điện thoại</label><input id="staff-phone" name="phone" type="tel" value="@Model.Phone" required maxlength="20" autocomplete="tel"></div>
              <div class="counter-field counter-field-full"><label for="staff-role">Vai trò</label><input id="staff-role" value="@Model.RoleLabel" disabled></div>
              <div class="counter-form-actions"><button class="counter-button" type="reset">Hủy</button><button class="counter-button counter-button-primary" type="submit">Lưu thông tin</button></div>
            </form></div>
          </section>
          <section class="counter-panel">
            <div class="counter-panel-head"><h2>Đổi mật khẩu</h2></div>
            <div class="counter-panel-body"><form class="counter-form-stack" asp-controller="Home" asp-action="ChangeStaffPassword" asp-route-screen="profile" method="post">
              @Html.AntiForgeryToken()
              @if (!string.IsNullOrWhiteSpace(Model.PasswordMessage))
              {
                <p class="counter-profile-feedback counter-profile-feedback-success" role="status">@Model.PasswordMessage</p>
              }
              @if (!string.IsNullOrWhiteSpace(Model.PasswordError))
              {
                <p class="counter-profile-feedback counter-profile-feedback-error" role="alert">@Model.PasswordError</p>
              }
              <div class="counter-field"><label for="current-password">Mật khẩu hiện tại</label><input id="current-password" name="currentPassword" type="password" autocomplete="current-password" required></div>
              <div class="counter-field"><label for="new-password">Mật khẩu mới</label><input id="new-password" name="newPassword" type="password" autocomplete="new-password" minlength="8" required></div>
              <div class="counter-field"><label for="confirm-password">Xác nhận mật khẩu mới</label><input id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required></div>
              <div class="counter-form-actions"><button class="counter-button counter-button-primary" type="submit">Cập nhật mật khẩu</button></div>
            </form></div>
          </section>
        </div>
      </section>
    </main>
  </div>

  <dialog class="counter-dialog" role="alertdialog" aria-labelledby="counter-dialog-title" aria-describedby="counter-dialog-description">
    <h2 id="counter-dialog-title">Xác nhận thao tác</h2>
    <p id="counter-dialog-description" data-dialog-copy>Vui lòng kiểm tra thông tin trước khi tiếp tục.</p>
    <div class="counter-field counter-dialog-reason" data-dialog-reason hidden><label for="action-reason">Lý do xử lý</label><input id="action-reason" required placeholder="Nhập lý do xử lý"></div>
    <div class="counter-dialog-actions"><button class="counter-button" type="button" data-dialog-close>Quay lại</button><button class="counter-button counter-button-primary" type="button" data-dialog-confirm>Xác nhận</button></div>
  </dialog>
  <dialog class="logout-dialog" id="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
    <div class="logout-heading">
      <span class="logout-icon"><i data-lucide="log-out" aria-hidden="true"></i></span>
      <div>
        <h2 id="logout-title">Đăng xuất khỏi tài khoản?</h2>
        <p id="logout-description">Bạn sẽ cần đăng nhập lại để tiếp tục.</p>
      </div>
    </div>
    <div class="logout-account">
      <i data-lucide="user-round" aria-hidden="true"></i><span>@fullName</span>
    </div>
    <form class="logout-actions" asp-controller="Auth" asp-action="Logout" method="post">
      <button class="button button-secondary" type="button" data-signout-cancel>Huỷ</button>
      <button class="button button-danger" type="submit" data-signout-confirm>Đăng xuất</button>
    </form>
  </dialog>
  <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
  <div class="counter-toast" role="status" aria-live="polite" hidden></div>
  <script src="~/js/counter.js"></script>
  <script src="~/js/auth.js"></script>
</body>
</html>
