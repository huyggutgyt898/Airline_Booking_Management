<main id="main-content">
    <section class="screen is-active" id="home-screen" data-screen="home" aria-labelledby="home-title">
      <div class="container">
        <div class="hero" data-wf-block="2">
          <div class="hero-copy">
            <p class="hero-eyebrow">Mỗi chuyến đi, một khởi đầu mới</p>
            <h1 id="home-title">Khám phá hành trình tiếp theo của bạn</h1>
            <p class="hero-description">Đặt vé nhanh chóng, an tâm tận hưởng mọi chuyến bay cùng TEO Airlines.</p>
          </div>

          <form class="search-card" id="flight-search-form" novalidate data-wf-block="3">
            <fieldset class="trip-type">
              <legend class="visually-hidden">Loại hành trình</legend>
              <label class="radio-option">
                <input type="radio" name="trip-type" value="oneway" checked>
                <span class="radio-mark" aria-hidden="true"></span>
                <span>Một chiều</span>
              </label>
              <label class="radio-option">
                <input type="radio" name="trip-type" value="roundtrip">
                <span class="radio-mark" aria-hidden="true"></span>
                <span>Khứ hồi</span>
              </label>
            </fieldset>

            <div class="flight-fields">
              <div class="route-fields">
                <div class="field">
                  <label for="origin">Điểm đi</label>
                  <input id="origin" name="origin" type="text" value="TP. Hồ Chí Minh (SGN)" list="airport-options" autocomplete="off" required>
                </div>
                <button class="swap-button" id="swap-route" type="button" aria-label="Đổi điểm đi và điểm đến">
                  <i data-lucide="arrow-left-right" aria-hidden="true"></i>
                </button>
                <div class="field">
                  <label for="destination">Điểm đến</label>
                  <input id="destination" name="destination" type="text" value="Hà Nội (HAN)" list="airport-options" autocomplete="off" required>
                </div>
                <datalist id="airport-options"></datalist>
              </div>

              <div class="field date-field" id="departure-field">
                <label>Ngày đi</label>
                <input id="departure-date" type="hidden" value="2026-11-21">
                <button class="field-trigger date-trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="departure-calendar">
                  <span id="departure-date-label">21/11/2026</span>
                  <i data-lucide="calendar-days" aria-hidden="true"></i>
                </button>
                <div class="calendar-popover" id="departure-calendar" role="dialog" aria-label="Chọn ngày đi" hidden></div>
              </div>

              <div class="field date-field is-disabled" id="return-field" hidden>
                <label>Ngày về</label>
                <input id="return-date" type="hidden" value="2026-11-28" disabled>
                <button class="field-trigger date-trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="return-calendar" disabled>
                  <span id="return-date-label">28/11/2026</span>
                  <i data-lucide="calendar-days" aria-hidden="true"></i>
                </button>
                <div class="calendar-popover" id="return-calendar" role="dialog" aria-label="Chọn ngày về" hidden></div>
              </div>

              <div class="field">
                <label>Hạng ghế</label>
                <button class="field-trigger select-trigger" id="cabin-trigger" type="button" aria-haspopup="listbox" aria-expanded="false">
                  <span id="cabin-value">Phổ thông</span>
                  <i data-lucide="chevron-down" aria-hidden="true"></i>
                </button>
                <div class="select-popover" id="cabin-options" role="listbox" aria-label="Hạng ghế" hidden>
                  <button type="button" role="option" aria-selected="true" data-cabin="Phổ thông">Phổ thông</button>
                  <button type="button" role="option" aria-selected="false" data-cabin="Thương gia">Thương gia</button>
                </div>
              </div>

              <div class="field passenger-field">
                <label>Hành khách</label>
                <button class="field-trigger passenger-trigger" id="passenger-trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="passenger-options">
                  <span id="passenger-summary">1 người lớn</span>
                  <i data-lucide="users" aria-hidden="true"></i>
                </button>
                <div class="passenger-popover" id="passenger-options" role="dialog" aria-label="Chọn số hành khách" hidden>
                  <div class="passenger-row">
                    <span>Người lớn<small>Từ 12 tuổi</small></span>
                    <div class="stepper">
                      <button type="button" data-count="adult" data-delta="-1" aria-label="Giảm số người lớn">−</button>
                      <output id="adult-count">1</output>
                      <button type="button" data-count="adult" data-delta="1" aria-label="Tăng số người lớn">+</button>
                    </div>
                  </div>
                  <div class="passenger-row">
                    <span>Trẻ em<small>Từ 2 đến dưới 12 tuổi</small></span>
                    <div class="stepper">
                      <button type="button" data-count="child" data-delta="-1" aria-label="Giảm số trẻ em">−</button>
                      <output id="child-count">0</output>
                      <button type="button" data-count="child" data-delta="1" aria-label="Tăng số trẻ em">+</button>
                    </div>
                  </div>
                  <div class="passenger-row">
                    <span>Em bé<small>Dưới 2 tuổi · không chiếm ghế</small></span>
                    <div class="stepper">
                      <button type="button" data-count="infant" data-delta="-1" aria-label="Giảm số em bé">−</button>
                      <output id="infant-count">0</output>
                      <button type="button" data-count="infant" data-delta="1" aria-label="Tăng số em bé">+</button>
                    </div>
                  </div>
                  <button class="button button-primary passenger-done" type="button" id="passenger-done">Xong</button>
                </div>
              </div>
            </div>

            <p class="field-error" id="search-error" role="alert" hidden></p>
            <div class="search-bottom">
              <p class="search-note">Giá hiển thị bao gồm thuế và phí.</p>
              <button class="button button-primary search-submit" id="search-submit" type="submit">
                <i data-lucide="search" aria-hidden="true"></i>
                <span>Tìm chuyến bay</span>
              </button>
            </div>
          </form>
        </div>

      </div>

    </section>

    <section class="screen" id="results-screen" data-screen="results" aria-labelledby="results-title" hidden>
      <div class="container page-container">
        <div class="page-heading">
          <div>
            <p class="eyebrow">Chọn chuyến bay</p>
            <h1 id="results-title">Chuyến bay đến Hà Nội</h1>
            <p class="subheading" id="results-summary">TP. Hồ Chí Minh (SGN) → Hà Nội (HAN) · Thứ Bảy, 21/11/2026</p>
          </div>
          <button class="button button-outline" type="button" data-screen-link="home">
            <i data-lucide="pencil" aria-hidden="true"></i> Sửa tìm kiếm
          </button>
        </div>

        <div class="results-layout">
          <aside class="filter-panel" aria-label="Bộ lọc chuyến bay">
            <div class="filter-heading"><h2>Bộ lọc</h2><button type="button" id="clear-filters">Xóa lọc</button></div>
            <fieldset class="filter-group">
              <legend>Điểm dừng</legend>
              <label><input type="checkbox" data-filter="direct"> Chuyến bay thẳng</label>
              <label><input type="checkbox" data-filter="stop"> Có điểm dừng</label>
            </fieldset>
            <fieldset class="filter-group">
              <legend>Khung giờ khởi hành</legend>
              <label><input type="checkbox" data-filter="morning"> Buổi sáng · 05:00–12:00</label>
              <label><input type="checkbox" data-filter="afternoon"> Buổi chiều · 12:00–18:00</label>
            </fieldset>
            <fieldset class="filter-group">
              <legend>Giá vé</legend>
              <label><input type="checkbox" data-filter="under-two"> Dưới 2.000.000 đ</label>
            </fieldset>
          </aside>

          <div class="flight-results">
            <div class="results-toolbar">
              <p><strong id="result-count">0 chuyến bay</strong><span> · Giá đã gồm thuế, phí</span></p>
              <label class="sort-control">Sắp xếp
                <select id="flight-sort" aria-label="Sắp xếp chuyến bay">
                  <option value="recommended">Đề xuất</option>
                  <option value="price">Giá thấp nhất</option>
                  <option value="departure">Giờ khởi hành</option>
                </select>
              </label>
            </div>

            <div class="flight-list" id="result-lists">
              <section class="flight-group" id="outbound-group" aria-labelledby="outbound-group-title">
                <h2 class="flight-group-title" id="outbound-group-title">Chuyến đi</h2>
                <div class="flight-list" id="outbound-list"></div>
              </section>

              <section class="flight-group" id="return-group" aria-labelledby="return-group-title" hidden>
                <h2 class="flight-group-title" id="return-group-title">Chuyến về</h2>
                <div class="flight-list" id="return-list"></div>
              </section>

              <div class="empty-state" id="empty-results" hidden>
                <span class="empty-icon"><i data-lucide="plane-takeoff" aria-hidden="true"></i></span>
                <h2>Không tìm thấy chuyến bay phù hợp</h2>
                <p>Thử bỏ bớt bộ lọc hoặc chọn một khung giờ khác.</p>
                <button class="button button-outline" type="button" id="empty-clear-filters">Xóa bộ lọc</button>
              </div>
            </div>

            <div class="results-actions">
              <p class="mock-note" id="selection-note">Chọn chuyến bay để tiếp tục.</p>
              <button class="button button-primary" type="button" id="continue-to-passengers" disabled>
                Tiếp tục nhập thông tin hành khách <i data-lucide="arrow-right" aria-hidden="true"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="screen" id="passengers-screen" data-screen="passengers" aria-labelledby="passengers-title" hidden>
      <div class="container page-container">
        <div class="page-heading">
          <div><p class="eyebrow">Thông tin đặt chỗ</p><h1 id="passengers-title">Thông tin hành khách</h1><p class="subheading">Nhập thông tin như trên giấy tờ tùy thân.</p></div>
        </div>
        <div class="booking-layout">
          <form class="panel booking-form" id="passenger-form" novalidate>
            <section class="form-section">
              <div class="section-heading"><span class="section-number">1</span><div><h2>Thông tin liên hệ</h2><p>Nhận thông tin cập nhật về chuyến bay và đặt chỗ.</p></div></div>
              <div class="form-grid">
                <div class="field"><label for="contact-name">Họ và tên người liên hệ</label><input id="contact-name" name="contact-name" type="text" placeholder="Nhập họ và tên" autocomplete="name" required></div>
                <div class="field"><label for="contact-email">Email</label><input id="contact-email" name="contact-email" type="email" placeholder="Nhập email nhận vé" autocomplete="email" required></div>
                <div class="field"><label for="contact-phone">Số điện thoại</label><input id="contact-phone" name="contact-phone" type="tel" placeholder="Ví dụ: 0912345678" autocomplete="tel" required></div>
              </div>
            </section>
            <div class="traveler-list" id="traveler-list"></div>
            <p class="field-error" id="passenger-error" role="alert" hidden></p>
            <div class="form-actions">
              <button class="button button-outline" type="button" data-screen-link="results"><i data-lucide="arrow-left" aria-hidden="true"></i> Quay lại</button>
              <button class="button button-primary" type="submit">Tiếp tục chọn ghế <i data-lucide="arrow-right" aria-hidden="true"></i></button>
            </div>
            <p class="mock-note">Thông tin hành khách được lưu cùng đặt chỗ để đối chiếu khi làm thủ tục.</p>
          </form>
          <aside class="booking-aside" id="passenger-summary-card" aria-label="Tóm tắt chuyến bay"></aside>
        </div>
      </div>
    </section>

    <section class="screen" id="seats-screen" data-screen="seats" aria-labelledby="seats-title" hidden>
      <div class="container page-container">
        <div class="page-heading">
          <div><p class="eyebrow">Tùy chọn chuyến đi</p><h1 id="seats-title">Chọn chỗ ngồi</h1><p class="subheading" id="seats-subheading">Chọn chỗ ngồi cho hành khách.</p></div>
        </div>
        <div class="booking-layout">
          <div class="seat-maps" id="seat-maps"></div>
          <aside class="booking-aside" id="seat-summary-card" aria-label="Tóm tắt chuyến bay"></aside>
        </div>
        <div class="page-actions">
          <button class="button button-outline" type="button" data-screen-link="passengers"><i data-lucide="arrow-left" aria-hidden="true"></i> Quay lại</button>
          <button class="button button-primary" type="button" id="continue-to-payment">Tiếp tục thanh toán <i data-lucide="arrow-right" aria-hidden="true"></i></button>
        </div>
      </div>
    </section>

    <section class="screen" id="payment-screen" data-screen="payment" aria-labelledby="payment-title" hidden>
      <div class="container page-container">
        <div class="page-heading">
          <div><p class="eyebrow">Kiểm tra và xác nhận</p><h1 id="payment-title">Xác nhận & thanh toán</h1><p class="subheading">Kiểm tra hành trình và tổng chi phí trước khi tiếp tục.</p></div>
        </div>
        <div class="booking-layout">
          <div class="payment-main">
            <section class="panel payment-panel">
              <div class="panel-heading"><div><h2>Phương thức thanh toán</h2><p>Chọn một phương thức để tiếp tục.</p></div></div>
              <fieldset class="payment-options">
                <legend class="visually-hidden">Chọn phương thức thanh toán</legend>
                <label class="payment-option is-selected">
                  <input type="radio" name="payment-method" value="momo" checked>
                  <span class="payment-radio"></span>
                  <span class="payment-symbol momo-symbol">M</span>
                  <span class="payment-copy"><strong>MoMo</strong><small>Giữ chỗ trong 10 phút</small></span>
                  <span class="payment-time">10 phút</span>
                </label>
                <label class="payment-option">
                  <input type="radio" name="payment-method" value="counter">
                  <span class="payment-radio"></span>
                  <span class="payment-symbol counter-symbol"><i data-lucide="landmark" aria-hidden="true"></i></span>
                  <span class="payment-copy"><strong>Tiền mặt hoặc chuyển khoản tại quầy</strong><small>Nhân viên xác nhận sau khi nhận thanh toán</small></span>
                  <span class="payment-time">1 giờ</span>
                </label>
              </fieldset>
              <div class="hold-notice" id="hold-notice" role="status">
                <i data-lucide="clock-3" aria-hidden="true"></i>
                <span>Thời gian giữ chỗ còn <strong id="hold-timer">10:00</strong>. Đơn chưa được xác nhận thanh toán.</span>
              </div>
            </section>

            <section class="panel promo-panel">
              <div class="panel-heading"><div><h2>Mã khuyến mãi</h2><p>Nhập mã ưu đãi nếu có.</p></div></div>
              <form class="promo-form" id="promo-form">
                <label class="visually-hidden" for="promo-code">Mã khuyến mãi</label>
                <input id="promo-code" type="text" placeholder="Nhập mã khuyến mãi" autocomplete="off">
                <button class="button button-outline" type="submit">Áp dụng</button>
              </form>
              <p class="promo-feedback" id="promo-feedback" aria-live="polite"></p>
            </section>

            <section class="panel fare-panel">
              <div class="panel-heading"><div><h2>Chi tiết giá</h2><p>Giá cuối cùng được hiển thị trước khi xác nhận.</p></div></div>
              <dl class="fare-breakdown" id="fare-breakdown"></dl>
              <div class="fare-total"><span>Tổng thanh toán</span><strong id="total-price">1.975.000 đ</strong></div>
              <p class="mock-note">Em bé dưới 2 tuổi không chiếm ghế riêng. Đơn được giữ chỗ 10 phút khi chọn MoMo và 1 giờ khi thanh toán tại quầy.</p>
            </section>

            <div class="form-actions payment-actions">
              <button class="button button-outline" type="button" data-screen-link="seats"><i data-lucide="arrow-left" aria-hidden="true"></i> Quay lại</button>
              <button class="button button-primary" type="button" id="confirm-booking">Xác nhận đặt chỗ</button>
            </div>
          </div>
          <aside class="booking-aside" id="payment-summary-card" aria-label="Tóm tắt chuyến bay"></aside>
        </div>
      </div>
    </section>

    <section class="screen" id="confirmation-screen" data-screen="confirmation" aria-labelledby="confirmation-title" hidden>
      <div class="container page-container confirmation-container">
        <section class="confirmation-card">
          <span class="confirmation-icon"><i data-lucide="check" aria-hidden="true"></i></span>
          <p class="eyebrow">Đặt chỗ</p>
          <h1 id="confirmation-title">Yêu cầu đặt chỗ đã được ghi nhận</h1>
          <p class="confirmation-copy">Mã đặt chỗ của bạn</p>
          <p class="booking-code" id="booking-code">—</p>
          <div class="status-banner status-pending">
            <i data-lucide="clock-3" aria-hidden="true"></i>
            <span><strong id="confirmation-status">Chờ xác nhận thanh toán</strong><small id="confirmation-status-note">Chưa ghi nhận thanh toán thành công.</small></span>
          </div>
          <div class="confirmation-summary" id="confirmation-summary"></div>
          <p class="mock-note" id="confirmation-note">Vui lòng hoàn tất thanh toán trong thời gian giữ chỗ để đơn không bị huỷ tự động.</p>
          <div class="confirmation-actions">
            <button class="button button-primary" type="button" data-screen-link="home">Về trang chủ</button>
            <a class="button button-outline" asp-controller="Home" asp-action="Lookup">
              <i data-lucide="search" aria-hidden="true"></i> Xem chi tiết đặt chỗ
            </a>
          </div>
        </section>
      </div>
    </section>
  </main>

@section Scripts {
  <script src="~/js/app.js"></script>
}