@{
    Layout = null;
}

<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0F766E">
  <meta name="description" content="Đăng nhập tài khoản TEO Airlines.">
  <title>Đăng nhập — TEO Airlines</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
  <link rel="stylesheet" href="~/css/style.css">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <a class="brand auth-brand" asp-controller="Home" asp-action="Index" aria-label="TEO Airlines — Về trang đặt vé">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.8 3.2c-.9-.9-2.2-.4-3.1.5l-4.3 4.3-7.8-2c-.5-.1-1 .1-1.4.4l-.9.9 5.7 3.2-3.1 3.1-2.8-.7L2 14l3.7 1.8L7.5 19l1.1-1.1-.7-2.8 3.1-3.1 3.2 5.7.9-.9c.4-.4.5-.9.4-1.4l-2-7.8 4.3-4.3c.9-.9 1.4-2.2.5-3.1z"></path>
        </svg>
      </span>
      <span class="brand-wordmark"><strong>TEO</strong><small>airlines</small></span>
    </a>

    <section class="auth-panel" aria-labelledby="auth-title">
      <div class="auth-heading">
        <h1 id="auth-title">Chào mừng trở lại</h1>
        <p>Đăng nhập để tiếp tục hành trình cùng TEO Airlines.</p>
      </div>

      <form class="auth-form" id="login-form" asp-controller="Auth" asp-action="Login" method="post">

        <!-- Hiển thị thông báo lỗi từ Controller nếu đăng nhập thất bại -->
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="auth-form-message" role="status" aria-live="polite" style="color: #0f766e; font-weight: 500; margin-bottom: 1rem;">
                @successMessage
            </div>
        }
        @if (ViewData["ErrorMessage"] != null)
        {
            <div class="auth-form-message text-danger mb-3" role="status" aria-live="polite" style="color: #dc2626; font-weight: 500; margin-bottom: 1rem;">
                @ViewData["ErrorMessage"]
            </div>
        }

        <div class="auth-field">
          <label for="login-identity">Email, số điện thoại hoặc tên đăng nhập</label>
          <input id="login-identity" name="identity" type="text" value="@(ViewData["Identity"])" autocomplete="username" placeholder="Nhập email, số điện thoại hoặc tên đăng nhập" required autofocus>
        </div>

        <div class="auth-field">
          <div class="auth-label-row">
            <label for="login-password">Mật khẩu</label>
            <a class="auth-inline-link" href="#support" data-forgot-password>Quên mật khẩu?</a>
          </div>
          <div class="auth-password-wrap">
            <input id="login-password" name="password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" minlength="8" required>
            <button class="password-toggle" type="button" aria-label="Hiện mật khẩu" aria-pressed="false" aria-controls="login-password" data-password-toggle>
              <svg class="password-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
                <circle cx="12" cy="12" r="3" />
              </svg>
              <svg class="password-icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" />
                <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" />
                <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" />
                <path d="m2 2 20 20" />
              </svg>
            </button>
          </div>
        </div>

        <button class="button button-primary auth-submit" type="submit" data-auth-submit>
          <span>Đăng nhập</span>
        </button>
      </form>

      <div class="auth-social">
        <div class="auth-divider" aria-hidden="true"><span>hoặc</span></div>
        <button class="button button-outline auth-google" type="button" data-google-auth>
          <span class="google-mark" aria-hidden="true">G</span>
          Đăng nhập bằng Google
        </button>
      </div>

      <p class="auth-switch">Chưa có tài khoản? <a asp-controller="Auth" asp-action="Register">Tạo tài khoản</a></p>
      <p class="auth-demo-note">Hệ thống đã kết nối cơ sở dữ liệu TEO Airlines.</p>
    </section>
  </main>
  <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
  
  <script src="~/js/auth.js"></script>
</body>
</html>